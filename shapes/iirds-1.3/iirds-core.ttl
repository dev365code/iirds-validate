  sh:description "Keep one iirds:relates-to-party and remove the rest. It names who set the status; several would leave responsibility unassigned rather than shared." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20190712-1.0.1-release/index.html#rdfproperties_core_iirdsAttribute:~:text=rdf%2Dschema%23Literal-,0..1%C2%A0%20iirds%3Arelates%2Dto%2Dparty%20property%20%2D%20iirds%3AParty,-iirds%3AContentLifeCycleStatusValue> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:ContentLifeCycleStatus ;
  sh:property ivs:M21.6-p .
ivs:M21.6-p a sh:PropertyShape ;
  sh:message "iirds:ContentLifeCycleStatus MUST NOT have more than one property iirds:relates-to-party." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M21.6" ;
  sh:description "Keep one iirds:relates-to-party and remove the rest. It names who set the status; several would leave responsibility unassigned rather than shared." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20190712-1.0.1-release/index.html#rdfproperties_core_iirdsAttribute:~:text=rdf%2Dschema%23Literal-,0..1%C2%A0%20iirds%3Arelates%2Dto%2Dparty%20property%20%2D%20iirds%3AParty,-iirds%3AContentLifeCycleStatusValue> ;
  sh:path iirds:relates-to-party ;
  sh:maxCount 1 .

ivs:M22.1 a sh:NodeShape ;
  rdfs:label "An iirds:Party MUST have a related iirds:PartyRole that is assigned by the property iirds:has-party-role, such as author, supplier or manufacturer." ;
  sh:severity sh:Violation ;
  sh:message "An iirds:Party MUST have a related iirds:PartyRole that is assigned by the property iirds:has-party-role, such as author, supplier or manufacturer." ;
  ivm:ruleId "M22.1" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:has-party-role to the Party, relating it to a PartyRole such as iirds:Author or iirds:Manufacturer. A party with no role tells a consumer that an organisation is involved and not how." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AParty%20MUST%20have%20a%20related%20iirds%3APartyRole%20that%20is%20assigned%20by%20the%20property%20iirds%3Ahas%2Dparty%2Drole%2C%20such%20as%20author%2C%20supplier%20or%20manufacturer.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Party ;
  sh:property ivs:M22.1-p .
ivs:M22.1-p a sh:PropertyShape ;
  sh:message "An iirds:Party MUST have a related iirds:PartyRole that is assigned by the property iirds:has-party-role, such as author, supplier or manufacturer." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M22.1" ;
  sh:description "Add iirds:has-party-role to the Party, relating it to a PartyRole such as iirds:Author or iirds:Manufacturer. A party with no role tells a consumer that an organisation is involved and not how." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AParty%20MUST%20have%20a%20related%20iirds%3APartyRole%20that%20is%20assigned%20by%20the%20property%20iirds%3Ahas%2Dparty%2Drole%2C%20such%20as%20author%2C%20supplier%20or%20manufacturer.> ;
  sh:path iirds:has-party-role ;
  sh:minCount 1 ;
  sh:maxCount 1 .

ivs:M23 a sh:NodeShape ;
  rdfs:label "In addition to the role, an iirds:Party MUST also have an associated description of itself as compliant vcard:kind object which is assigned via iirds:relates-to-vcard." ;
  sh:severity sh:Violation ;
  sh:message "In addition to the role, an iirds:Party MUST also have an associated description of itself as compliant vcard:kind object which is assigned via iirds:relates-to-vcard." ;
  ivm:ruleId "M23" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:relates-to-vcard on the Party, pointing at a vCard that describes it. The role says what the party does; the vCard says who it is, which is what a reader needs to make contact." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=In%20addition%20to%20the%20role%2C%20an%20iirds%3AParty%20MUST%20also%20have%20an%20associated%20description%20of%20itself%20as%20compliant%20vcard%3Akind%20object%20which%20is%20assigned%20via%20iirds%3Arelates%2Dto%2Dvcard.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Party ;
  sh:property ivs:M23-p .
ivs:M23-p a sh:PropertyShape ;
  sh:message "In addition to the role, an iirds:Party MUST also have an associated description of itself as compliant vcard:kind object which is assigned via iirds:relates-to-vcard." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M23" ;
  sh:description "Add iirds:relates-to-vcard on the Party, pointing at a vCard that describes it. The role says what the party does; the vCard says who it is, which is what a reader needs to make contact." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=In%20addition%20to%20the%20role%2C%20an%20iirds%3AParty%20MUST%20also%20have%20an%20associated%20description%20of%20itself%20as%20compliant%20vcard%3Akind%20object%20which%20is%20assigned%20via%20iirds%3Arelates%2Dto%2Dvcard.> ;
  sh:path iirds:relates-to-vcard ;
  sh:minCount 1 ;
  sh:maxCount 1 .

ivs:M24.1 a sh:NodeShape ;
  rdfs:label "iirds:DirectoryNode MUST NOT have more than one property iirds:has-next-sibling." ;
  sh:severity sh:Violation ;
  sh:message "iirds:DirectoryNode MUST NOT have more than one property iirds:has-next-sibling." ;
  ivm:ruleId "M24.1" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:has-next-sibling and remove the rest. A node has one successor in its level; two would make the table of contents a graph rather than a list." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=Navigation%20sequences%20and%20hierarchies%20of%20InformationUnits%20MUST%20be%20modeled%20as%20linked%20lists%20of%20instances%20of%20the%20class%20iirds%3ADirectoryNode.%20In%20a%20linked%20list%2C%20an%20iirds%3ADirectoryNode%20references%20the%20following%20node%20by%20the%20property%20iirds%3Ahas%2Dnext%2Dsibling.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:DirectoryNode ;
  sh:property ivs:M24.1-p .
ivs:M24.1-p a sh:PropertyShape ;
  sh:message "iirds:DirectoryNode MUST NOT have more than one property iirds:has-next-sibling." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M24.1" ;
  sh:description "Keep one iirds:has-next-sibling and remove the rest. A node has one successor in its level; two would make the table of contents a graph rather than a list." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=Navigation%20sequences%20and%20hierarchies%20of%20InformationUnits%20MUST%20be%20modeled%20as%20linked%20lists%20of%20instances%20of%20the%20class%20iirds%3ADirectoryNode.%20In%20a%20linked%20list%2C%20an%20iirds%3ADirectoryNode%20references%20the%20following%20node%20by%20the%20property%20iirds%3Ahas%2Dnext%2Dsibling.> ;
  sh:path iirds:has-next-sibling ;
  sh:maxCount 1 .

ivs:M24.2 a sh:NodeShape ;
  rdfs:label "iirds:DirectoryNode MUST NOT have more than one property iirds:has-directory-structure-type." ;
  sh:severity sh:Violation ;
  sh:message "iirds:DirectoryNode MUST NOT have more than one property iirds:has-directory-structure-type." ;
  ivm:ruleId "M24.2" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:has-directory-structure-type and remove the rest. It says what kind of structure this is, and one node cannot be the root of two kinds at once." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=0..1%C2%A0%20iirds%3Ahas%2Ddirectory%2Dstructure%2Dtype%20property%20%2D%20iirds%3ADirectoryNodeType> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:DirectoryNode ;
  sh:property ivs:M24.2-p .
ivs:M24.2-p a sh:PropertyShape ;
  sh:message "iirds:DirectoryNode MUST NOT have more than one property iirds:has-directory-structure-type." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M24.2" ;
  sh:description "Keep one iirds:has-directory-structure-type and remove the rest. It says what kind of structure this is, and one node cannot be the root of two kinds at once." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=0..1%C2%A0%20iirds%3Ahas%2Ddirectory%2Dstructure%2Dtype%20property%20%2D%20iirds%3ADirectoryNodeType> ;
  sh:path iirds:has-directory-structure-type ;
  sh:maxCount 1 .

ivs:M24.3 a sh:NodeShape ;
  rdfs:label "iirds:DirectoryNode MUST NOT have more than one property iirds:has-first-child property." ;
  sh:severity sh:Violation ;
  sh:message "iirds:DirectoryNode MUST NOT have more than one property iirds:has-first-child property." ;
  ivm:ruleId "M24.3" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:has-first-child and remove the rest. A level begins at one node, and the rest of it is reached by following siblings from there." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#:~:text=0..1%C2%A0%20iirds%3Ahas%2Dfirst%2Dchild%20property%20%2D%20iirds%3ADirectoryNode> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:DirectoryNode ;
  sh:property ivs:M24.3-p .
ivs:M24.3-p a sh:PropertyShape ;
  sh:message "iirds:DirectoryNode MUST NOT have more than one property iirds:has-first-child property." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M24.3" ;
  sh:description "Keep one iirds:has-first-child and remove the rest. A level begins at one node, and the rest of it is reached by following siblings from there." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#:~:text=0..1%C2%A0%20iirds%3Ahas%2Dfirst%2Dchild%20property%20%2D%20iirds%3ADirectoryNode> ;
  sh:path iirds:has-first-child ;
  sh:maxCount 1 .

ivs:M24.4 a sh:NodeShape ;
  rdfs:label "iirds:DirectoryNode MUST NOT have more than one property iirds:relates-to-information-unit." ;
  sh:severity sh:Violation ;
  sh:message "iirds:DirectoryNode MUST NOT have more than one property iirds:relates-to-information-unit." ;
  ivm:ruleId "M24.4" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:relates-to-information-unit and remove the rest. A directory node stands for one entry in the table of contents." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#:~:text=0..1%C2%A0%20iirds%3Arelates%2Dto%2Dinformation%2Dunit%20property%20%2D%20iirds%3AInformationUnit> ;
  ivm:versions "1.1,1.2,1.3" ;
  sh:targetClass iirds:DirectoryNode ;
  sh:property ivs:M24.4-p .
ivs:M24.4-p a sh:PropertyShape ;
  sh:message "iirds:DirectoryNode MUST NOT have more than one property iirds:relates-to-information-unit." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M24.4" ;
  sh:description "Keep one iirds:relates-to-information-unit and remove the rest. A directory node stands for one entry in the table of contents." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#:~:text=0..1%C2%A0%20iirds%3Arelates%2Dto%2Dinformation%2Dunit%20property%20%2D%20iirds%3AInformationUnit> ;
  sh:path iirds:relates-to-information-unit ;
  sh:maxCount 1 .

ivs:M24.5 a sh:NodeShape ;
  rdfs:label "The root node of a directory structure MUST have one property iirds:has-directory-structure-type." ;
  sh:severity sh:Violation ;
  sh:message "The root node of a directory structure MUST have one property iirds:has-directory-structure-type." ;
  ivm:ruleId "M24.5" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:has-directory-structure-type to the root node. It is what tells a consumer whether this structure is a table of contents, a parts list, or something else, and only the root carries it." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=Only%20root%20nodes%20of%20a%20directory%20structure%20MUST%20have%20the%20property%20iirds%3Ahas%2Ddirectory%2Dstructure%2Dtype.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetObjectsOf iirds:has-first-child, iirds:has-next-sibling ;
  sh:or ( [ sh:not [ sh:or ( [ sh:class iirds:DirectoryNode ] [ sh:class iirds:nil ] ) ] ] [ sh:property [ sh:path iirds:has-directory-structure-type ; sh:maxCount 0 ] ] ) .

ivs:M25 a sh:NodeShape ;
  rdfs:label "To model closed lists, the last node in a list level MUST have the property iirds:has-next-sibling relating to an instance of the class iirds:nil." ;
  sh:severity sh:Violation ;
  sh:message "To model closed lists, the last node in a list level MUST have the property iirds:has-next-sibling relating to an instance of the class iirds:nil." ;
  ivm:ruleId "M25" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:has-next-sibling pointing at iirds:nil on the last node of the level, or at the next iirds:DirectoryNode if the level continues. Without the terminator a consumer cannot distinguish the end of a list from data that was truncated in transit." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=To%20model%20closed%20lists%2C%20the%20last%20node%20in%20a%20list%20level%20MUST%20have%20the%20property%20iirds%3Ahas%2Dnext%2Dsibling%20relating%20to%20an%20instance%20of%20the%20class%20iirds%3Anil.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetObjectsOf iirds:has-first-child, iirds:has-next-sibling ;
  sh:or ( [ sh:in ( iirds:nil ) ] [ sh:class iirds:nil ] [ sh:not [ sh:or ( [ sh:class iirds:DirectoryNode ] [ sh:class iirds:nil ] ) ] ] [ sh:property [ sh:path iirds:has-next-sibling ; sh:qualifiedValueShape [ sh:or ( [ sh:in ( iirds:nil ) ] [ sh:class iirds:DirectoryNode ] [ sh:class iirds:nil ] ) ] ; sh:qualifiedMinCount 1 ] ] ) .

ivs:M26 a sh:NodeShape ;
  rdfs:label "To model hierarchy levels in the navigation structure, an iirds:DirectoryNode instance MUST reference an iirds:DirectoryNode instance on the next lower level by the property iirds:has-first-child." ;
  sh:severity sh:Violation ;
  sh:message "To model hierarchy levels in the navigation structure, an iirds:DirectoryNode instance MUST reference an iirds:DirectoryNode instance on the next lower level by the property iirds:has-first-child." ;
  ivm:ruleId "M26" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Point iirds:has-first-child at an iirds:DirectoryNode. A lower level starts with a node like any other, and pointing at something else breaks the walk." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=To%20model%20hierarchy%20levels%20in%20the%20navigation%20structure%2C%20an%20iirds%3ADirectoryNode%20instance%20MUST%20reference%20an%20iirds%3ADirectoryNode%20instance%20on%20the%20next%20lower%20level%20by%20the%20property%20iirds%3Ahas%2Dfirst%2Dchild.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetObjectsOf iirds:has-first-child ;
  sh:or ( [ sh:in ( iirds:nil ) ] [ sh:class iirds:DirectoryNode ] [ sh:class iirds:nil ] ) .

ivs:M27 a sh:NodeShape ;
  rdfs:label "The directory node on the next lower level MUST be the first item of another linked list." ;
  sh:severity sh:Violation ;
  sh:message "The directory node on the next lower level MUST be the first item of another linked list." ;
  ivm:ruleId "M27" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Make the first child of the lower level the head of its own sibling chain. Each level is a linked list, and the child link enters it at the first item." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=The%20directory%20node%20on%20the%20next%20lower%20level%20MUST%20be%20the%20first%20item%20of%20another%20linked%20list.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetObjectsOf iirds:has-first-child ;
  sh:property ivs:M27-p .
ivs:M27-p a sh:PropertyShape ;
  sh:message "The directory node on the next lower level MUST be the first item of another linked list." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M27" ;
  sh:description "Make the first child of the lower level the head of its own sibling chain. Each level is a linked list, and the child link enters it at the first item." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=The%20directory%20node%20on%20the%20next%20lower%20level%20MUST%20be%20the%20first%20item%20of%20another%20linked%20list.> ;
  sh:path [ sh:inversePath iirds:has-next-sibling ] ;
  sh:maxCount 0 .

ivs:M35 a sh:NodeShape ;
  rdfs:label "iirds:Identity MUST have property iirds:identifier" ;
  sh:severity sh:Violation ;
  sh:message "iirds:Identity MUST have property iirds:identifier" ;
  ivm:ruleId "M35" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:identifier to the Identity, holding the value. An identity with a domain and no value names a scheme without saying which member of it." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=1%C2%A0%20iirds%3Aidentifier%20property%20%2D%20http%3A//www.w3.org/2000/01/rdf%2Dschema%23Literal> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Identity ;
  sh:property ivs:M35-p .
ivs:M35-p a sh:PropertyShape ;
  sh:message "iirds:Identity MUST have property iirds:identifier" ;
  sh:severity sh:Violation ;
  ivm:ruleId "M35" ;
  sh:description "Add iirds:identifier to the Identity, holding the value. An identity with a domain and no value names a scheme without saying which member of it." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=1%C2%A0%20iirds%3Aidentifier%20property%20%2D%20http%3A//www.w3.org/2000/01/rdf%2Dschema%23Literal> ;
  sh:path iirds:identifier ;
  sh:minCount 1 ;
  sh:maxCount 1 .

ivs:M36 a sh:NodeShape ;
  rdfs:label "iirds:Identity MUST have property iirds:IdentityDomain" ;
  sh:severity sh:Violation ;
  sh:message "iirds:Identity MUST have property iirds:IdentityDomain" ;
  ivm:ruleId "M36" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Relate the Identity to an iirds:IdentityDomain. Serial numbers and asset URIs are only unique within a scheme, so the value alone is ambiguous." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfrelations_core_has-identity-domain:~:text=1%C2%A0%20iirds%3Ahas%2Didentity%2Ddomain%20property%20%2D%20iirds%3AIdentityDomain> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Identity ;
  sh:property ivs:M36-p .
ivs:M36-p a sh:PropertyShape ;
  sh:message "iirds:Identity MUST have property iirds:IdentityDomain" ;
  sh:severity sh:Violation ;
  ivm:ruleId "M36" ;
  sh:description "Relate the Identity to an iirds:IdentityDomain. Serial numbers and asset URIs are only unique within a scheme, so the value alone is ambiguous." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfrelations_core_has-identity-domain:~:text=1%C2%A0%20iirds%3Ahas%2Didentity%2Ddomain%20property%20%2D%20iirds%3AIdentityDomain> ;
  sh:path iirds:has-identity-domain ;
  sh:minCount 1 ;
  sh:maxCount 1 .

ivs:M37 a sh:NodeShape ;
  rdfs:label "instances of Document must have an IRI" ;
  sh:severity sh:Violation ;
  sh:message "instances of Document must have an IRI" ;
  ivm:ruleId "M37" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Give the <iirds:Document> element an rdf:about with an IRI, for example rdf:about=\"urn:uuid:...\" or a URL under a domain you control. Without one the element is anonymous, so no other statement can refer to it and a consumer merging this package with another cannot tell two of them apart." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#about-iirds> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Document ;
  sh:nodeKind sh:IRI ;
  sh:not [ sh:in ( <urn:iirds:package:> ) ] .

ivs:M38 a sh:NodeShape ;
  rdfs:label "instances of Component must have an IRI" ;
  sh:severity sh:Violation ;
  sh:message "instances of Component must have an IRI" ;
  ivm:ruleId "M38" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Give the <iirds:Component> element an rdf:about with an IRI, for example rdf:about=\"urn:uuid:...\" or a URL under a domain you control. Without one the element is anonymous, so no other statement can refer to it and a consumer merging this package with another cannot tell two of them apart." ;
