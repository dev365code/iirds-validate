ivs:L7 a sh:NodeShape ;
  rdfs:label "every information unit should have a title" ;
  sh:severity sh:Warning ;
  sh:message "every information unit should have a title" ;
  ivm:ruleId "L7" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Add an iirds:title. It is what appears in a table of contents and in search results, and an information unit without one arrives unnamed." ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Document, iirds:Fragment, iirds:InformationUnit, iirds:Package, iirds:Topic ;
  sh:or ( [ sh:class iirds:Package ] [ sh:property [ sh:path iirds:title ; sh:minCount 1 ] ] ) .

ivs:M2.1 a sh:NodeShape ;
  rdfs:label "An instance of an iirds:InformationUnit subclass MUST have an IRI." ;
  sh:severity sh:Violation ;
  sh:message "An instance of an iirds:InformationUnit subclass MUST have an IRI." ;
  ivm:ruleId "M2.1" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Give the element an rdf:about with an IRI. Anonymous information units cannot be referenced from a table of contents, from another package, or from a later revision of this one." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#nested-iirds-packages:~:text=An%20instance%20of%20an%20iirds%3AInformationUnit%20subclass%20MUST%20have%20an%20IRI%20and%20MUST%20NOT%20be%20a%20blank%20node.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Document, iirds:Fragment, iirds:InformationUnit, iirds:Package, iirds:Topic ;
  sh:nodeKind sh:IRI ;
  sh:not [ sh:in ( <urn:iirds:package:> ) ] .

ivs:M2.3 a sh:NodeShape ;
  rdfs:label "iirds:InformationUnit MUST NOT have more than one property iirds:dateOfCreation." ;
  sh:severity sh:Violation ;
  sh:message "iirds:InformationUnit MUST NOT have more than one property iirds:dateOfCreation." ;
  ivm:ruleId "M2.3" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:dateOfCreation and remove the rest. Two creation dates give a consumer no way to choose, and most will silently take whichever they read first." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3AdateOfCreation%20property%20%2D%20http%3A//www.w3.org/2001/XMLSchema%23dateTimeStamp> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Document, iirds:Fragment, iirds:InformationUnit, iirds:Package, iirds:Topic ;
  sh:property ivs:M2.3-p .
ivs:M2.3-p a sh:PropertyShape ;
  sh:message "iirds:InformationUnit MUST NOT have more than one property iirds:dateOfCreation." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M2.3" ;
  sh:description "Keep one iirds:dateOfCreation and remove the rest. Two creation dates give a consumer no way to choose, and most will silently take whichever they read first." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3AdateOfCreation%20property%20%2D%20http%3A//www.w3.org/2001/XMLSchema%23dateTimeStamp> ;
  sh:path iirds:dateOfCreation ;
  sh:maxCount 1 .

ivs:M2.4 a sh:NodeShape ;
  rdfs:label "iirds:InformationUnit MUST NOT have more than one property iirds:dateOfLastModification." ;
  sh:severity sh:Violation ;
  sh:message "iirds:InformationUnit MUST NOT have more than one property iirds:dateOfLastModification." ;
  ivm:ruleId "M2.4" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:dateOfLastModification and remove the rest. Consumers use it to decide whether a redelivery is newer, so an ambiguous value defeats the comparison." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3AdateOfLastModification%20property%20%2D%20http%3A//www.w3.org/2001/XMLSchema%23dateTimeStamp> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Document, iirds:Fragment, iirds:InformationUnit, iirds:Package, iirds:Topic ;
  sh:property ivs:M2.4-p .
ivs:M2.4-p a sh:PropertyShape ;
  sh:message "iirds:InformationUnit MUST NOT have more than one property iirds:dateOfLastModification." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M2.4" ;
  sh:description "Keep one iirds:dateOfLastModification and remove the rest. Consumers use it to decide whether a redelivery is newer, so an ambiguous value defeats the comparison." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3AdateOfLastModification%20property%20%2D%20http%3A//www.w3.org/2001/XMLSchema%23dateTimeStamp> ;
  sh:path iirds:dateOfLastModification ;
  sh:maxCount 1 .

ivs:M2.5 a sh:NodeShape ;
  rdfs:label "iirds:InformationUnit MUST NOT have more than one property iirds:revision." ;
  sh:severity sh:Violation ;
  sh:message "iirds:InformationUnit MUST NOT have more than one property iirds:revision." ;
  ivm:ruleId "M2.5" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:revision and remove the rest. It is the identifier a reader quotes when reporting a problem, and two of them make that useless." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3Arevision%20property%20%2D%20http%3A//www.w3.org/2000/01/rdf%2Dschema%23Literal> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Document, iirds:Fragment, iirds:InformationUnit, iirds:Package, iirds:Topic ;
  sh:property ivs:M2.5-p .
ivs:M2.5-p a sh:PropertyShape ;
  sh:message "iirds:InformationUnit MUST NOT have more than one property iirds:revision." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M2.5" ;
  sh:description "Keep one iirds:revision and remove the rest. It is the identifier a reader quotes when reporting a problem, and two of them make that useless." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3Arevision%20property%20%2D%20http%3A//www.w3.org/2000/01/rdf%2Dschema%23Literal> ;
  sh:path iirds:revision ;
  sh:maxCount 1 .

ivs:M2.6 a sh:NodeShape ;
  rdfs:label "iirds:InformationUnit MUST NOT have more than one property iirds:title." ;
  sh:severity sh:Violation ;
  sh:message "iirds:InformationUnit MUST NOT have more than one property iirds:title." ;
  ivm:ruleId "M2.6" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:title and remove the rest. Where the same content exists in several languages, the specification models that as one information unit per language, all related to the same iirds:InformationObject (section 6.10.1)." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3Atitle%20property%20%2D%20http%3A//www.w3.org/2000/01/rdf%2Dschema%23Literal> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Document, iirds:Fragment, iirds:InformationUnit, iirds:Package, iirds:Topic ;
  sh:property ivs:M2.6-p .
ivs:M2.6-p a sh:PropertyShape ;
  sh:message "iirds:InformationUnit MUST NOT have more than one property iirds:title." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M2.6" ;
  sh:description "Keep one iirds:title and remove the rest. Where the same content exists in several languages, the specification models that as one information unit per language, all related to the same iirds:InformationObject (section 6.10.1)." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3Atitle%20property%20%2D%20http%3A//www.w3.org/2000/01/rdf%2Dschema%23Literal> ;
  sh:path iirds:title ;
  sh:maxCount 1 .

ivs:M2.7 a sh:NodeShape ;
  rdfs:label "iirds:InformationUnit MUST NOT have more than one property iirds:has-abstract." ;
  sh:severity sh:Violation ;
  sh:message "iirds:InformationUnit MUST NOT have more than one property iirds:has-abstract." ;
  ivm:ruleId "M2.7" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:has-abstract and remove the rest. An abstract is what a search result shows, and there is room for one." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3Ahas%2Dabstract%20property> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Document, iirds:Fragment, iirds:InformationUnit, iirds:Package, iirds:Topic ;
  sh:property ivs:M2.7-p .
ivs:M2.7-p a sh:PropertyShape ;
  sh:message "iirds:InformationUnit MUST NOT have more than one property iirds:has-abstract." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M2.7" ;
  sh:description "Keep one iirds:has-abstract and remove the rest. An abstract is what a search result shows, and there is room for one." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3Ahas%2Dabstract%20property> ;
  sh:path iirds:has-abstract ;
  sh:maxCount 1 .

ivs:M2.8 a sh:NodeShape ;
  rdfs:label "iirds:InformationUnit MUST NOT have more than one property iirds:is-replacement-of." ;
  sh:severity sh:Violation ;
  sh:message "iirds:InformationUnit MUST NOT have more than one property iirds:is-replacement-of." ;
  ivm:ruleId "M2.8" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:is-replacement-of and remove the rest. If this unit genuinely supersedes several, model that on the units it replaces instead." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3Ais%2Dreplacement%2Dof%20property%20%2D%20iirds%3AInformationUnit> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Document, iirds:Fragment, iirds:InformationUnit, iirds:Package, iirds:Topic ;
  sh:property ivs:M2.8-p .
ivs:M2.8-p a sh:PropertyShape ;
  sh:message "iirds:InformationUnit MUST NOT have more than one property iirds:is-replacement-of." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M2.8" ;
  sh:description "Keep one iirds:is-replacement-of and remove the rest. If this unit genuinely supersedes several, model that on the units it replaces instead." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3Ais%2Dreplacement%2Dof%20property%20%2D%20iirds%3AInformationUnit> ;
  sh:path iirds:is-replacement-of ;
  sh:maxCount 1 .

ivs:M2.9 a sh:NodeShape ;
  rdfs:label "iirds:InformationUnit MUST NOT have more than one property iirds:is-version-of ." ;
  sh:severity sh:Violation ;
  sh:message "iirds:InformationUnit MUST NOT have more than one property iirds:is-version-of ." ;
  ivm:ruleId "M2.9" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:is-version-of and remove the rest. A version belongs to exactly one information object; two would make the revision history a graph nobody can walk." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3Ais%2Dversion%2Dof%20property%20%2D%20iirds%3AInformationObject> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Document, iirds:Fragment, iirds:InformationUnit, iirds:Package, iirds:Topic ;
  sh:property ivs:M2.9-p .
ivs:M2.9-p a sh:PropertyShape ;
  sh:message "iirds:InformationUnit MUST NOT have more than one property iirds:is-version-of ." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M2.9" ;
  sh:description "Keep one iirds:is-version-of and remove the rest. A version belongs to exactly one information object; two would make the revision history a graph nobody can walk." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3Ais%2Dversion%2Dof%20property%20%2D%20iirds%3AInformationObject> ;
  sh:path iirds:is-version-of ;
  sh:maxCount 1 .

ivs:M4 a sh:NodeShape ;
  rdfs:label "iiRDS:Package MUST use property iirds:iiRDSVersion" ;
  sh:severity sh:Violation ;
  sh:message "iiRDS:Package MUST use property iirds:iiRDSVersion" ;
  ivm:ruleId "M4" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:iiRDSVersion to the iirds:Package instance, with a published version such as 1.3. A consumer needs it to decide which rules apply before reading anything else." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#nested-iirds-packages:~:text=0..1-,iirds%3APackage,1,-iirds%3AParty> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Package ;
  sh:property ivs:M4-p .
ivs:M4-p a sh:PropertyShape ;
  sh:message "iiRDS:Package MUST use property iirds:iiRDSVersion" ;
  sh:severity sh:Violation ;
  ivm:ruleId "M4" ;
  sh:description "Add iirds:iiRDSVersion to the iirds:Package instance, with a published version such as 1.3. A consumer needs it to decide which rules apply before reading anything else." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#nested-iirds-packages:~:text=0..1-,iirds%3APackage,1,-iirds%3AParty> ;
  sh:path iirds:iiRDSVersion ;
  sh:minCount 1 ;
  sh:maxCount 1 .

ivs:M6 a sh:NodeShape ;
  rdfs:label "If information objects are used, each information unit MUST only be related to exactly one information object via iirds:is-version-of." ;
  sh:severity sh:Violation ;
  sh:message "If information objects are used, each information unit MUST only be related to exactly one information object via iirds:is-version-of." ;
  ivm:ruleId "M6" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Relate the information unit to exactly one information object with iirds:is-version-of. Two would make it a version of two different things at once, and a consumer merging revisions cannot resolve that." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=If%20information%20objects%20are%20used%2C%20each%20information%20unit%20MUST%20only%20be%20related%20to%20exactly%20one%20information%20object%20via%20iirds%3Ais%2Dversion%2Dof.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Document, iirds:Fragment, iirds:InformationUnit, iirds:Package, iirds:Topic ;
  sh:property ivs:M6-p .
ivs:M6-p a sh:PropertyShape ;
  sh:message "If information objects are used, each information unit MUST only be related to exactly one information object via iirds:is-version-of." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M6" ;
  sh:description "Relate the information unit to exactly one information object with iirds:is-version-of. Two would make it a version of two different things at once, and a consumer merging revisions cannot resolve that." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=If%20information%20objects%20are%20used%2C%20each%20information%20unit%20MUST%20only%20be%20related%20to%20exactly%20one%20information%20object%20via%20iirds%3Ais%2Dversion%2Dof.> ;
  sh:path iirds:is-version-of ;
  sh:maxCount 1 .

ivs:M7.1 a sh:NodeShape ;
  rdfs:label "instances of InformationObject must have an IRI" ;
  sh:severity sh:Violation ;
  sh:message "instances of InformationObject must have an IRI" ;
  ivm:ruleId "M7.1" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Give the <iirds:InformationObject> element an rdf:about with an IRI, for example rdf:about=\"urn:uuid:...\" or a URL under a domain you control. Without one the element is anonymous, so no other statement can refer to it and a consumer merging this package with another cannot tell two of them apart." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20information%20object%20MUST%20have%20an%20absolute%20IRI%20and%20MAY%20be%20related%20to%20additional%20identifications%20via%20the%20iirds%3Ahas%2Didentity%20property.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:InformationObject ;
  sh:nodeKind sh:IRI ;
  sh:not [ sh:in ( <urn:iirds:package:> ) ] .

ivs:M8 a sh:NodeShape ;
  rdfs:label "iirds:Package elements representing the enclosing iiRDS package itself MUST NOT be subjects of any iirds:has-rendition relation." ;
  sh:severity sh:Violation ;
  sh:message "iirds:Package elements representing the enclosing iiRDS package itself MUST NOT be subjects of any iirds:has-rendition relation." ;
  ivm:ruleId "M8" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Remove the iirds:has-rendition relations whose subject is the iirds:Package element for this container. A rendition is the file an information unit is delivered as, and this package is what the delivery is, not something inside it. A package nested inside another one is content and may have renditions; this one is not nested inside anything." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=iirds%3APackage%20elements%20representing%20the%20enclosing%20iiRDS%20package%20itself%20MUST%20NOT%20be%20subjects%20of%20any%20iirds%3Ahas%2Drendition%20relation.> ;
  ivm:versions "1.1,1.2,1.3" ;
  sh:targetClass iirds:Package ;
  sh:or ( [ sh:property [ sh:path [ sh:zeroOrOnePath iirds:is-part-of-package ] ; sh:qualifiedValueShape [ sh:class iirds:Package ] ; sh:qualifiedMinCount 2 ] ] [ sh:property [ sh:path iirds:has-rendition ; sh:maxCount 0 ] ] ) .

ivs:M9 a sh:NodeShape ;
  rdfs:label "The URL MUST be relative to the root folder of the iiRDS package" ;
  sh:severity sh:Violation ;
  sh:message "The URL MUST be relative to the root folder of the iiRDS package" ;
  ivm:ruleId "M9" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Make the URL relative to the container root, such as content/topic1.xhtml. An absolute path or a file: URL points outside the package, where a consumer has nothing." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=The%20URL%20MUST%20be%20relative%20to%20the%20root%20folder%20of%20the%20iiRDS%20package.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Rendition ;
  sh:property ivs:M9-p .
ivs:M9-p a sh:PropertyShape ;
  sh:message "The URL MUST be relative to the root folder of the iiRDS package" ;
  sh:severity sh:Violation ;
  ivm:ruleId "M9" ;
  sh:description "Make the URL relative to the container root, such as content/topic1.xhtml. An absolute path or a file: URL points outside the package, where a consumer has nothing." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=The%20URL%20MUST%20be%20relative%20to%20the%20root%20folder%20of%20the%20iiRDS%20package.> ;
  sh:path iirds:source ;
  sh:not [ sh:pattern "(://|^/)" ] .

ivs:M10 a sh:NodeShape ;
  rdfs:label "An iirds:Rendition MUST have the property iirds:source." ;
  sh:severity sh:Violation ;
  sh:message "An iirds:Rendition MUST have the property iirds:source." ;
  ivm:ruleId "M10" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:source to the Rendition, naming the file inside the container it renders. A Rendition without one describes a form of the content that the package does not carry." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#properties-and-relations-overview:~:text=1-,iirds%3ARendition,1,-iirds%3ARendition> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Rendition ;
  sh:property ivs:M10-p .
ivs:M10-p a sh:PropertyShape ;
  sh:message "An iirds:Rendition MUST have the property iirds:source." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M10" ;
  sh:description "Add iirds:source to the Rendition, naming the file inside the container it renders. A Rendition without one describes a form of the content that the package does not carry." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#properties-and-relations-overview:~:text=1-,iirds%3ARendition,1,-iirds%3ARendition> ;
  sh:path iirds:source ;
  sh:minCount 1 ;
  sh:maxCount 1 .

ivs:M11 a sh:NodeShape ;
  rdfs:label "An iirds:Rendition MUST have the property iirds:format." ;
  sh:severity sh:Violation ;
  sh:message "An iirds:Rendition MUST have the property iirds:format." ;
  ivm:ruleId "M11" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Give the Rendition exactly one iirds:format, holding the media type of the file it points at, for example application/xhtml+xml or application/pdf. Add one if there is none; remove the extras if there are several." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3ARendition%20MUST%20also%20have%20the%20property%20iirds%3Aformat.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Rendition ;
  sh:property ivs:M11-p .
ivs:M11-p a sh:PropertyShape ;
  sh:message "An iirds:Rendition MUST have the property iirds:format." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M11" ;
  sh:description "Give the Rendition exactly one iirds:format, holding the media type of the file it points at, for example application/xhtml+xml or application/pdf. Add one if there is none; remove the extras if there are several." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3ARendition%20MUST%20also%20have%20the%20property%20iirds%3Aformat.> ;
  sh:path iirds:format ;
  sh:minCount 1 ;
  sh:maxCount 1 .

ivs:M13.1 a sh:NodeShape ;
  rdfs:label "To select parts of a file, an iirds:Selector MUST have an rdf:value and dcterms:conformsTo. The value MUST conform to the standard specified by the property dcterms:conformsTo. Only a standard from the following list of fragment selectors MUST be used: [https://www.w3.org/TR/annotation-model/#fragment-selector]." ;
  sh:severity sh:Violation ;
  sh:message "To select parts of a file, an iirds:Selector MUST have an rdf:value and dcterms:conformsTo. The value MUST conform to the standard specified by the property dcterms:conformsTo. Only a standard from the following list of fragment selectors MUST be used: [https://www.w3.org/TR/annotation-model/#fragment-selector]." ;
  ivm:ruleId "M13.1" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add rdf:value to the Selector, holding the expression that picks out the part, and dcterms:conformsTo naming the scheme it is written in. Without the value there is nothing to evaluate." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=To%20select%20parts,fragment%2Dselector%5D.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:FragmentSelector, iirds:RangeSelector, iirds:Selector ;
  sh:or ( [ sh:class iirds:RangeSelector ] [ sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ] ] ) .

ivs:M13.2 a sh:NodeShape ;
  rdfs:label "To select parts of a file, an iirds:Selector MUST have an rdf:value and dcterms:conformsTo. The value MUST conform to the standard specified by the property dcterms:conformsTo. Only a standard from the following list of fragment selectors MUST be used: [https://www.w3.org/TR/annotation-model/#fragment-selector]." ;
  sh:severity sh:Violation ;
  sh:message "To select parts of a file, an iirds:Selector MUST have an rdf:value and dcterms:conformsTo. The value MUST conform to the standard specified by the property dcterms:conformsTo. Only a standard from the following list of fragment selectors MUST be used: [https://www.w3.org/TR/annotation-model/#fragment-selector]." ;
  ivm:ruleId "M13.2" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add dcterms:conformsTo to the Selector, naming the scheme its rdf:value is written in, such as an XPath or media fragment specification. Without it a consumer cannot tell how to interpret the expression." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=To%20select%20parts,fragment%2Dselector%5D.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:FragmentSelector, iirds:RangeSelector, iirds:Selector ;
  sh:or ( [ sh:class iirds:RangeSelector ] [ sh:property [ sh:path <http://purl.org/dc/terms/conformsTo> ; sh:minCount 1 ; sh:maxCount 1 ] ] ) .

ivs:M14.1 a sh:NodeShape ;
  rdfs:label "iirds:RangeSelector must use property iirds:has-start-selector." ;
  sh:severity sh:Violation ;
  sh:message "iirds:RangeSelector must use property iirds:has-start-selector." ;
  ivm:ruleId "M14.1" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:has-start-selector to the RangeSelector. A range is defined by its two endpoints, so one missing leaves it unresolvable." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=The%20iirds%3ARangeSelector%20points,end%2Dselector.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:RangeSelector ;
  sh:property ivs:M14.1-p .
ivs:M14.1-p a sh:PropertyShape ;
  sh:message "iirds:RangeSelector must use property iirds:has-start-selector." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M14.1" ;
  sh:description "Add iirds:has-start-selector to the RangeSelector. A range is defined by its two endpoints, so one missing leaves it unresolvable." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=The%20iirds%3ARangeSelector%20points,end%2Dselector.> ;
  sh:path iirds:has-start-selector ;
  sh:minCount 1 ;
  sh:maxCount 1 .

ivs:M14.2 a sh:NodeShape ;
  rdfs:label "iirds:RangeSelector must use property iirds:has-end-selector." ;
  sh:severity sh:Violation ;
  sh:message "iirds:RangeSelector must use property iirds:has-end-selector." ;
  ivm:ruleId "M14.2" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:has-end-selector to the RangeSelector. A range with only a start selects from there to nowhere in particular." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=The%20iirds%3ARangeSelector%20points,end%2Dselector.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:RangeSelector ;
  sh:property ivs:M14.2-p .
ivs:M14.2-p a sh:PropertyShape ;
  sh:message "iirds:RangeSelector must use property iirds:has-end-selector." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M14.2" ;
  sh:description "Add iirds:has-end-selector to the RangeSelector. A range with only a start selects from there to nowhere in particular." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=The%20iirds%3ARangeSelector%20points,end%2Dselector.> ;
  sh:path iirds:has-end-selector ;
  sh:minCount 1 ;
  sh:maxCount 1 .

ivs:M15.1 a sh:NodeShape ;
  rdfs:label "Instances of the iirds:Document class MUST have one or more relations to one of the standardized iirds:DocumentTypes defined in iirds:InformationType > iirds:DocumentType." ;
  sh:severity sh:Violation ;
  sh:message "Instances of the iirds:Document class MUST have one or more relations to one of the standardized iirds:DocumentTypes defined in iirds:InformationType > iirds:DocumentType." ;
  ivm:ruleId "M15.1" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Relate the Document to one of the standardised iiRDS document types. It is what a consumer uses to route a document — installation, maintenance, spare parts — before anyone opens it." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=Instances%20of%20the%20iirds%3ADocument%20class%20MUST%20have%20one%20or%20more%20relations%20to%20one%20of%20the%20standardized%20iirds%3ADocumentTypes%20defined%20in%20iirds%3AInformationType%20%3E%20iirds%3ADocumentType.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Document ;
  sh:property ivs:M15.1-p .
ivs:M15.1-p a sh:PropertyShape ;
  sh:message "Instances of the iirds:Document class MUST have one or more relations to one of the standardized iirds:DocumentTypes defined in iirds:InformationType > iirds:DocumentType." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M15.1" ;
  sh:description "Relate the Document to one of the standardised iiRDS document types. It is what a consumer uses to route a document — installation, maintenance, spare parts — before anyone opens it." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=Instances%20of%20the%20iirds%3ADocument%20class%20MUST%20have%20one%20or%20more%20relations%20to%20one%20of%20the%20standardized%20iirds%3ADocumentTypes%20defined%20in%20iirds%3AInformationType%20%3E%20iirds%3ADocumentType.> ;
  sh:path [ sh:alternativePath ( iirds:has-document-type iirds:is-applicable-for-document-type ) ] ;
  sh:minCount 1 .

ivs:M19.1 a sh:NodeShape ;
  rdfs:label "An identity MUST point to exactly one domain by the iirds:has-identity-domain property." ;
  sh:severity sh:Violation ;
  sh:message "An identity MUST point to exactly one domain by the iirds:has-identity-domain property." ;
  ivm:ruleId "M19.1" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Give the Identity exactly one iirds:has-identity-domain. The domain says which scheme the identifier belongs to, and an identifier without a scheme is a string that may collide with anything." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AIdentity%20instance%20consists,of%20the%20iirdsIdentityDomain%20class.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Identity ;
  sh:property ivs:M19.1-p .
ivs:M19.1-p a sh:PropertyShape ;
  sh:message "An identity MUST point to exactly one domain by the iirds:has-identity-domain property." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M19.1" ;
  sh:description "Give the Identity exactly one iirds:has-identity-domain. The domain says which scheme the identifier belongs to, and an identifier without a scheme is a string that may collide with anything." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AIdentity%20instance%20consists,of%20the%20iirdsIdentityDomain%20class.> ;
  sh:path iirds:identifier ;
  sh:minCount 1 ;
  sh:maxCount 1 .

ivs:M19.2 a sh:NodeShape ;
  rdfs:label "An iirds:Identity instance consists of two parts: the value and the domain. The value MUST be provided as a non-empty string in the iirds:identifier property. " ;
  sh:severity sh:Violation ;
  sh:message "An iirds:Identity instance consists of two parts: the value and the domain. The value MUST be provided as a non-empty string in the iirds:identifier property. " ;
  ivm:ruleId "M19.2" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:identifier to the Identity, holding the value itself. The domain says what kind of identifier it is; this is the identifier." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AIdentity%20instance%20consists,of%20the%20iirdsIdentityDomain%20class.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Identity ;
  sh:property ivs:M19.2-p .
ivs:M19.2-p a sh:PropertyShape ;
  sh:message "An iirds:Identity instance consists of two parts: the value and the domain. The value MUST be provided as a non-empty string in the iirds:identifier property. " ;
  sh:severity sh:Violation ;
  ivm:ruleId "M19.2" ;
  sh:description "Add iirds:identifier to the Identity, holding the value itself. The domain says what kind of identifier it is; this is the identifier." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AIdentity%20instance%20consists,of%20the%20iirdsIdentityDomain%20class.> ;
  sh:path iirds:identifier ;
  sh:minCount 1 ;
  sh:or ( [ sh:nodeKind sh:BlankNode ] [ sh:pattern "\\S" ] ) .

ivs:M19.3 a sh:NodeShape ;
  rdfs:label "An identity MUST point to exactly one domain by the iirds:has-identity-domain property." ;
  sh:severity sh:Violation ;
  sh:message "An identity MUST point to exactly one domain by the iirds:has-identity-domain property." ;
  ivm:ruleId "M19.3" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Relate the Identity to exactly one domain with iirds:has-identity-domain, removing the extras. Two domains would make one value mean two different things at once." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AIdentity%20instance%20consists,of%20the%20iirdsIdentityDomain%20class.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:Identity ;
  sh:property ivs:M19.3-p .
ivs:M19.3-p a sh:PropertyShape ;
  sh:message "An identity MUST point to exactly one domain by the iirds:has-identity-domain property." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M19.3" ;
  sh:description "Relate the Identity to exactly one domain with iirds:has-identity-domain, removing the extras. Two domains would make one value mean two different things at once." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AIdentity%20instance%20consists,of%20the%20iirdsIdentityDomain%20class.> ;
  sh:path iirds:has-identity-domain ;
  sh:minCount 1 ;
  sh:maxCount 1 .

ivs:M20.1 a sh:NodeShape ;
  rdfs:label "instances of IdentityDomain must have an IRI" ;
  sh:severity sh:Violation ;
  sh:message "instances of IdentityDomain must have an IRI" ;
  ivm:ruleId "M20.1" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Give the <iirds:IdentityDomain> element an rdf:about with an IRI, for example rdf:about=\"urn:uuid:...\" or a URL under a domain you control. Without one the element is anonymous, so no other statement can refer to it and a consumer merging this package with another cannot tell two of them apart." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=Instances%20of%20class%20iirds%3AIdentityDomain%20MUST%20have%20an%20absolute%20IRI%20and%20MAY%20link%20to%20the%20custodian%20of%20the%20domain%20via%20the%20iirds%3Ahas%2Dparty%20property.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:IdentityDomain ;
  sh:nodeKind sh:IRI ;
  sh:not [ sh:in ( <urn:iirds:package:> ) ] .

ivs:M21.1 a sh:NodeShape ;
  rdfs:label "An iirds:ContentLifecyleStatus MUST have an iirds:ContentLifecyleStatusValue which is assigned by the iirds:has-content-lifecycle-status-value property." ;
  sh:severity sh:Violation ;
  sh:message "An iirds:ContentLifecyleStatus MUST have an iirds:ContentLifecyleStatusValue which is assigned by the iirds:has-content-lifecycle-status-value property." ;
  ivm:ruleId "M21.1" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Relate the ContentLifeCycleStatus to an iirds:ContentLifeCycleStatusValue with iirds:has-content-lifecycle-status-value. Without it the status object records dates for a status nobody named." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AContentLifecyleStatus%20MUST%20have%20an%20iirds%3AContentLifecyleStatusValue%20which%20is%20assigned%20by%20the%20iirds%3Ahas%2Dcontent%2Dlifecycle%2Dstatus%2Dvalue%20property.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:ContentLifeCycleStatus ;
  sh:property ivs:M21.1-p .
ivs:M21.1-p a sh:PropertyShape ;
  sh:message "An iirds:ContentLifecyleStatus MUST have an iirds:ContentLifecyleStatusValue which is assigned by the iirds:has-content-lifecycle-status-value property." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M21.1" ;
  sh:description "Relate the ContentLifeCycleStatus to an iirds:ContentLifeCycleStatusValue with iirds:has-content-lifecycle-status-value. Without it the status object records dates for a status nobody named." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AContentLifecyleStatus%20MUST%20have%20an%20iirds%3AContentLifecyleStatusValue%20which%20is%20assigned%20by%20the%20iirds%3Ahas%2Dcontent%2Dlifecycle%2Dstatus%2Dvalue%20property.> ;
  sh:path iirds:has-content-lifecycle-status-value ;
  sh:minCount 1 ;
  sh:maxCount 1 .

ivs:M21.2 a sh:NodeShape ;
  rdfs:label "iirds:ContentLifeCycleStatus MUST NOT have more than one property iirds:dateOfEffect." ;
  sh:severity sh:Violation ;
  sh:message "iirds:ContentLifeCycleStatus MUST NOT have more than one property iirds:dateOfEffect." ;
  ivm:ruleId "M21.2" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:dateOfEffect and remove the rest. It is the date a consumer uses to decide whether this status applies today." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20180418-1.0-release/index.html#:~:text=0..1%C2%A0%20iirds%3AdateOfEffect%20property%20%2D%20http%3A//www.w3.org/2001/XMLSchema%23dateTimeStamp> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:ContentLifeCycleStatus ;
  sh:property ivs:M21.2-p .
ivs:M21.2-p a sh:PropertyShape ;
  sh:message "iirds:ContentLifeCycleStatus MUST NOT have more than one property iirds:dateOfEffect." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M21.2" ;
  sh:description "Keep one iirds:dateOfEffect and remove the rest. It is the date a consumer uses to decide whether this status applies today." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20180418-1.0-release/index.html#:~:text=0..1%C2%A0%20iirds%3AdateOfEffect%20property%20%2D%20http%3A//www.w3.org/2001/XMLSchema%23dateTimeStamp> ;
  sh:path iirds:dateOfEffect ;
  sh:maxCount 1 .

ivs:M21.3 a sh:NodeShape ;
  rdfs:label "iirds:ContentLifeCycleStatus MUST NOT have more than one property iirds:dateOfExpiry." ;
  sh:severity sh:Violation ;
  sh:message "iirds:ContentLifeCycleStatus MUST NOT have more than one property iirds:dateOfExpiry." ;
  ivm:ruleId "M21.3" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:dateOfExpiry and remove the rest. Two expiry dates give no answer to the only question the property is asked." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#functional-metadata:~:text=0..1%C2%A0%20iirds%3AdateOfExpiry%20property%20%2D%20http%3A//www.w3.org/2001/XMLSchema%23dateTimeStamp> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:ContentLifeCycleStatus ;
  sh:property ivs:M21.3-p .
ivs:M21.3-p a sh:PropertyShape ;
  sh:message "iirds:ContentLifeCycleStatus MUST NOT have more than one property iirds:dateOfExpiry." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M21.3" ;
  sh:description "Keep one iirds:dateOfExpiry and remove the rest. Two expiry dates give no answer to the only question the property is asked." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#functional-metadata:~:text=0..1%C2%A0%20iirds%3AdateOfExpiry%20property%20%2D%20http%3A//www.w3.org/2001/XMLSchema%23dateTimeStamp> ;
  sh:path iirds:dateOfExpiry ;
  sh:maxCount 1 .

ivs:M21.4 a sh:NodeShape ;
  rdfs:label "iirds:ContentLifeCycleStatus MUST NOT have more than one property iirds:purpose." ;
  sh:severity sh:Violation ;
  sh:message "iirds:ContentLifeCycleStatus MUST NOT have more than one property iirds:purpose." ;
  ivm:ruleId "M21.4" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:dateOfStatus and remove the rest. It records when the status was set, which is what distinguishes a current status from a stale one." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#functional-metadata:~:text=0..1%C2%A0%20iirds%3AdateOfStatus%20property%20%2D%20http%3A//www.w3.org/2001/XMLSchema%23dateTimeStamp> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:ContentLifeCycleStatus ;
  sh:property ivs:M21.4-p .
ivs:M21.4-p a sh:PropertyShape ;
  sh:message "iirds:ContentLifeCycleStatus MUST NOT have more than one property iirds:purpose." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M21.4" ;
  sh:description "Keep one iirds:dateOfStatus and remove the rest. It records when the status was set, which is what distinguishes a current status from a stale one." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#functional-metadata:~:text=0..1%C2%A0%20iirds%3AdateOfStatus%20property%20%2D%20http%3A//www.w3.org/2001/XMLSchema%23dateTimeStamp> ;
  sh:path iirds:dateOfStatus ;
  sh:maxCount 1 .

ivs:M21.5 a sh:NodeShape ;
  rdfs:label "Properties: 0..1  iirds:purpose property - http://www.w3.org/2000/01/rdf-schema#Literal" ;
  sh:severity sh:Violation ;
  sh:message "Properties: 0..1  iirds:purpose property - http://www.w3.org/2000/01/rdf-schema#Literal" ;
  ivm:ruleId "M21.5" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:purpose and remove the rest. It says why the status exists, and a consumer displays it as a single line." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#functional-metadata:~:text=0..1%C2%A0%20iirds%3Apurpose%20property%20%2D%20http%3A//www.w3.org/2000/01/rdf%2Dschema%23Literal> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:ContentLifeCycleStatus ;
  sh:property ivs:M21.5-p .
ivs:M21.5-p a sh:PropertyShape ;
  sh:message "Properties: 0..1  iirds:purpose property - http://www.w3.org/2000/01/rdf-schema#Literal" ;
  sh:severity sh:Violation ;
  ivm:ruleId "M21.5" ;
  sh:description "Keep one iirds:purpose and remove the rest. It says why the status exists, and a consumer displays it as a single line." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#functional-metadata:~:text=0..1%C2%A0%20iirds%3Apurpose%20property%20%2D%20http%3A//www.w3.org/2000/01/rdf%2Dschema%23Literal> ;
  sh:path iirds:purpose ;
  sh:maxCount 1 .

ivs:M21.6 a sh:NodeShape ;
  rdfs:label "iirds:ContentLifeCycleStatus MUST NOT have more than one property iirds:relates-to-party." ;
  sh:severity sh:Violation ;
  sh:message "iirds:ContentLifeCycleStatus MUST NOT have more than one property iirds:relates-to-party." ;
  ivm:ruleId "M21.6" ;
