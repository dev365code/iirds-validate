  sh:message "iirds:Component MUST NOT have more than 1 property iirds:relates-to-party" ;
  ivm:ruleId "M95" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Keep one iirds:relates-to-party on the Component and remove the rest. If several organisations are genuinely involved, model each on its own relation type rather than repeating this one." ;
