  sh:description "Give the <iirds:ProductMetadata> element an rdf:about with an IRI, for example rdf:about=\"urn:uuid:...\" or a URL under a domain you control. Without one the element is anonymous, so no other statement can refer to it and a consumer merging this package with another cannot tell two of them apart." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfrelations_core_has-content-lifecycle-status-value> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:ProductMetadata ;
  sh:nodeKind sh:IRI ;
  sh:not [ sh:in ( <urn:iirds:package:> ) ] .

