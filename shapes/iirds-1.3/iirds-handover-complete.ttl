  ivm:ruleId "M92" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Give the <iirds:PuttingToUse> element an rdf:about with an IRI, for example rdf:about=\"urn:uuid:...\" or a URL under a domain you control. Without one the element is anonymous, so no other statement can refer to it and a consumer merging this package with another cannot tell two of them apart." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfrelations_core_has-content-lifecycle-status-value> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetClass iirds:PuttingToUse ;
  sh:nodeKind sh:IRI ;
  sh:not [ sh:in ( <urn:iirds:package:> ) ] .

ivs:M93 a sh:NodeShape ;
  rdfs:label "instances of Qualification must have an IRI" ;
  sh:severity sh:Violation ;
  sh:message "instances of Qualification must have an IRI" ;
  ivm:ruleId "M93" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Give the <iirds:Qualification> element an rdf:about with an IRI, for example rdf:about=\"urn:uuid:...\" or a URL under a domain you control. Without one the element is anonymous, so no other statement can refer to it and a consumer merging this package with another cannot tell two of them apart." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfrelations_core_has-content-lifecycle-status-value> ;
