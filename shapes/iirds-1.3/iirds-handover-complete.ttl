  ivm:ruleId "M2.9" ;
  sh:description "Keep one iirds:is-version-of and remove the rest. A version belongs to exactly one information object; two would make the revision history a graph nobody can walk." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#rdfclasses_core_InformationUnit:~:text=0..1%C2%A0%20iirds%3Ais%2Dversion%2Dof%20property%20%2D%20iirds%3AInformationObject> ;
  sh:path iirds:is-version-of ;
  sh:maxCount 1 .

ivs:M4 a sh:NodeShape ;
  rdfs:label "iiRDS:Package MUST use property iirds:iiRDSVersion" ;
  sh:severity sh:Violation ;
  sh:message "iiRDS:Package MUST use property iirds:iiRDSVersion" ;
  ivm:ruleId "M4" ;
  ivm:ruleSource "catalogue" ;
