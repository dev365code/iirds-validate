ivs:M24.6 a sh:NodeShape ;
  rdfs:label "There MUST be at least one root node that has the elements iirds:has-directory-structure-type, iirds:has-first-child and iirds:has-next-sibling and is not itself referenced as iirds:next-sibling or iirds:first-child." ;
  sh:severity sh:Violation ;
  sh:message "There MUST be at least one root node that has the elements iirds:has-directory-structure-type, iirds:has-first-child and iirds:has-next-sibling and is not itself referenced as iirds:next-sibling or iirds:first-child." ;
  ivm:ruleId "M24.6" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Give the package at least one root node carrying iirds:has-directory-structure-type together with its first child. Without a root there is no entry point, and the whole structure is unreachable." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=6.9.1-,Directory%20Nodes> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetNode ivs:M24.6 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?nt .
  FILTER (?nt IN (<http://iirds.tekom.de/iirds#DirectoryNode>, <http://iirds.tekom.de/iirds#nil>))
  FILTER NOT EXISTS { ?root <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?rt .
      FILTER (?rt IN (<http://iirds.tekom.de/iirds#DirectoryNode>, <http://iirds.tekom.de/iirds#nil>))
      ?root <http://iirds.tekom.de/iirds#has-directory-structure-type> ?t ; <http://iirds.tekom.de/iirds#has-first-child> ?c } }""" ] .

ivs:M30 a sh:NodeShape ;
  rdfs:label "The file metadata.rdf MUST NOT contain the iiRDS schema or iiRDS domain extensions." ;
  sh:severity sh:Violation ;
  sh:message "The file metadata.rdf MUST NOT contain the iiRDS schema or iiRDS domain extensions." ;
  ivm:ruleId "M30" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Remove the statement. It restates a relationship the iiRDS ontology already defines, which bloats every package and lets a stale copy contradict the real one. Linking your own class to an iiRDS class is a different thing and is allowed." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=The%20file%20metadata.rdf%20MUST%20NOT%20contain%20the%20iiRDS%20schema%20or%20iiRDS%20domain%20extensions.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetNode ivs:M30 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  { ?value a <http://www.w3.org/2000/01/rdf-schema#Class> } UNION { ?value a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> }
  UNION { ?value ?p ?o .
          FILTER (?p IN (<http://www.w3.org/2000/01/rdf-schema#subClassOf>, <http://www.w3.org/2000/01/rdf-schema#subPropertyOf>,
                         <http://www.w3.org/2000/01/rdf-schema#domain>, <http://www.w3.org/2000/01/rdf-schema#range>))
          FILTER (STRSTARTS(STR(?o), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?o), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?o), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?o), "http://iirds.tekom.de/iirds/domain/software#")) }
  FILTER (STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#")) }""" ] .

ivs:S4 a sh:NodeShape ;
  rdfs:label "iirds:iiRDSVersion must name a published version of the standard" ;
  sh:severity sh:Violation ;
  sh:message "iirds:iiRDSVersion must name a published version of the standard" ;
  ivm:ruleId "S4" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Set iirds:iiRDSVersion to a version the standard has published: 1.0, 1.0.1, 1.1, 1.2 or 1.3. A version nobody published cannot be validated against, and rounding it up would silently check the wrong rules." ;
  sh:targetSubjectsOf iirds:iiRDSVersion ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#iiRDSVersion> ?value .
  FILTER (!REGEX(STR(?value), "^\\\\s*(1[.]0|1[.]0[.]1|1[.]1|1[.]2|1[.]3)\\\\s*$")) }""" ] .

ivs:S5 a sh:NodeShape ;
  rdfs:label "iirds:formatRestriction must name a published profile" ;
  sh:severity sh:Violation ;
  sh:message "iirds:formatRestriction must name a published profile" ;
  ivm:ruleId "S5" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Set iirds:formatRestriction to a published profile, or remove the property to mean the unrestricted one. A value matching no profile would otherwise switch off both rule sets at once." ;
  sh:targetSubjectsOf iirds:formatRestriction ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#formatRestriction> ?value .
  FILTER (!REGEX(STR(?value), "^\\\\s*(A|H)?\\\\s*$")) }""" ] .

ivs:M15.2 a sh:NodeShape ;
  rdfs:label "In iiRDS/H the following metadata is mandatory for each iirds:Document: one iirdsHov:has-document-category." ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H the following metadata is mandatory for each iirds:Document: one iirdsHov:has-document-category." ;
  ivm:ruleId "M15.2" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add exactly one iirdsHov:has-document-category to the Document, naming one of the handover document categories. In iiRDS/H a receiving plant sorts incoming documents by this before anything reads them." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:Document ;
  sh:property ivs:M15.2-p .
ivs:M15.2-p a sh:PropertyShape ;
  sh:message "In iiRDS/H the following metadata is mandatory for each iirds:Document: one iirdsHov:has-document-category." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M15.2" ;
  sh:description "Add exactly one iirdsHov:has-document-category to the Document, naming one of the handover document categories. In iiRDS/H a receiving plant sorts incoming documents by this before anything reads them." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  sh:path iirdsHov:has-document-category ;
  sh:minCount 1 ;
  sh:maxCount 1 .

ivs:M15.3 a sh:NodeShape ;
  rdfs:label "In iiRDS/H the following metadata is mandatory for each iirds:Document: iirds:language." ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H the following metadata is mandatory for each iirds:Document: iirds:language." ;
  ivm:ruleId "M15.3" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:language to the Document, as a BCP 47 tag such as en or de-DE. A handover package crosses organisations, and the receiving side cannot infer which language a file is in." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:Document ;
  sh:property ivs:M15.3-p .
ivs:M15.3-p a sh:PropertyShape ;
  sh:message "In iiRDS/H the following metadata is mandatory for each iirds:Document: iirds:language." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M15.3" ;
  sh:description "Add iirds:language to the Document, as a BCP 47 tag such as en or de-DE. A handover package crosses organisations, and the receiving side cannot infer which language a file is in." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  sh:path iirds:language ;
  sh:minCount 1 .

ivs:M15.4 a sh:NodeShape ;
  rdfs:label "In iiRDS/H the following metadata is mandatory for each iirds:Document: iirds:title." ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H the following metadata is mandatory for each iirds:Document: iirds:title." ;
  ivm:ruleId "M15.4" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:title to the Document. It is what appears in the receiving system's document list, and a handover document without one arrives unnamed among hundreds." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:Document ;
  sh:property ivs:M15.4-p .
ivs:M15.4-p a sh:PropertyShape ;
  sh:message "In iiRDS/H the following metadata is mandatory for each iirds:Document: iirds:title." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M15.4" ;
  sh:description "Add iirds:title to the Document. It is what appears in the receiving system's document list, and a handover document without one arrives unnamed among hundreds." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  sh:path iirds:title ;
  sh:minCount 1 .

ivs:M15.5 a sh:NodeShape ;
  rdfs:label "In iiRDS/H the following metadata is mandatory for each iirds:Document: one iirds:is-version-of relating to an iirds:InformationObject" ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H the following metadata is mandatory for each iirds:Document: one iirds:is-version-of relating to an iirds:InformationObject" ;
  ivm:ruleId "M15.5" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add one iirds:is-version-of relating the Document to an iirds:InformationObject. That link is how a plant recognises a later delivery as a revision of a document it already holds instead of as a new one." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:Document ;
  sh:property ivs:M15.5-p .
ivs:M15.5-p a sh:PropertyShape ;
  sh:message "In iiRDS/H the following metadata is mandatory for each iirds:Document: one iirds:is-version-of relating to an iirds:InformationObject" ;
  sh:severity sh:Violation ;
  ivm:ruleId "M15.5" ;
  sh:description "Add one iirds:is-version-of relating the Document to an iirds:InformationObject. That link is how a plant recognises a later delivery as a revision of a document it already holds instead of as a new one." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  sh:path iirds:is-version-of ;
  sh:qualifiedValueShape [ sh:class iirds:InformationObject ] ;
  sh:qualifiedMinCount 1 ;
  sh:qualifiedMaxCount 1 .

ivs:M15.6 a sh:NodeShape ;
  rdfs:label "In iiRDS/H the following metadata is mandatory for each iirds:Document: iirds:has-rendition" ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H the following metadata is mandatory for each iirds:Document: iirds:has-rendition" ;
  ivm:ruleId "M15.6" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:has-rendition to the Document, pointing at a Rendition whose iirds:source names a file in this container. Without it the metadata describes a document the package does not actually deliver." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:Document ;
  sh:property ivs:M15.6-p .
ivs:M15.6-p a sh:PropertyShape ;
  sh:message "In iiRDS/H the following metadata is mandatory for each iirds:Document: iirds:has-rendition" ;
  sh:severity sh:Violation ;
  ivm:ruleId "M15.6" ;
  sh:description "Add iirds:has-rendition to the Document, pointing at a Rendition whose iirds:source names a file in this container. Without it the metadata describes a document the package does not actually deliver." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  sh:path iirds:has-rendition ;
  sh:minCount 1 .

ivs:M15.11b a sh:NodeShape ;
  rdfs:label "An iiRDS/H package MUST NOT contain instances of iirds:DirectoryNode." ;
  sh:severity sh:Violation ;
  sh:message "An iiRDS/H package MUST NOT contain instances of iirds:DirectoryNode." ;
  ivm:ruleId "M15.11b" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Remove the iirds:DirectoryNode instances. iiRDS/H carries documents, not a navigation tree; a handover package is filed by the receiving system rather than browsed as authored." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#restrictions-regarding-the-use-of-classes-and-instances> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:DirectoryNode, iirds:nil ;
  sh:not [ ] .

ivs:M15.11c a sh:NodeShape ;
  rdfs:label "An iiRDS/H package MUST NOT contain instances of iirds:Selector." ;
  sh:severity sh:Violation ;
  sh:message "An iiRDS/H package MUST NOT contain instances of iirds:Selector." ;
  ivm:ruleId "M15.11c" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Remove the iirds:Selector instances. iiRDS/H delivers whole documents, so addressing a fragment inside one has no meaning on the receiving side." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#restrictions-regarding-the-use-of-classes-and-instances> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:FragmentSelector, iirds:RangeSelector, iirds:Selector ;
  sh:not [ ] .

ivs:M15.7a a sh:NodeShape ;
  rdfs:label "In iiRDS/H each iirds:Document must have at least one iirds:relates-to-product-variant relating to an iirds:ProductVariant. This iirds:ProductVariant MUST relate to an iirds:Identity with an iirds:IdentityDomain that has an iirds:has-identity-type of either iirds:ObjectInstanceURI, iirds:ObjectTypeURI or iirds:SerialNumber." ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H each iirds:Document must have at least one iirds:relates-to-product-variant relating to an iirds:ProductVariant. This iirds:ProductVariant MUST relate to an iirds:Identity with an iirds:IdentityDomain that has an iirds:has-identity-type of either iirds:ObjectInstanceURI, iirds:ObjectTypeURI or iirds:SerialNumber." ;
  ivm:ruleId "M15.7a" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:relates-to-product-variant on the Document, relating it to the product variant it documents. In a handover the receiving plant files documents against equipment, and this is the link that makes that possible." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:Document ;
  sh:property ivs:M15.7a-p1 ;
  sh:property ivs:M15.7a-p2 .
ivs:M15.7a-p1 a sh:PropertyShape ;
  sh:message "In iiRDS/H each iirds:Document must have at least one iirds:relates-to-product-variant relating to an iirds:ProductVariant. This iirds:ProductVariant MUST relate to an iirds:Identity with an iirds:IdentityDomain that has an iirds:has-identity-type of either iirds:ObjectInstanceURI, iirds:ObjectTypeURI or iirds:SerialNumber." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M15.7a" ;
  sh:description "Add iirds:relates-to-product-variant on the Document, relating it to the product variant it documents. In a handover the receiving plant files documents against equipment, and this is the link that makes that possible." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  sh:path iirds:relates-to-product-variant ;
  sh:minCount 1 .
ivs:M15.7a-p2 a sh:PropertyShape ;
  sh:message "In iiRDS/H each iirds:Document must have at least one iirds:relates-to-product-variant relating to an iirds:ProductVariant. This iirds:ProductVariant MUST relate to an iirds:Identity with an iirds:IdentityDomain that has an iirds:has-identity-type of either iirds:ObjectInstanceURI, iirds:ObjectTypeURI or iirds:SerialNumber." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M15.7a" ;
  sh:description "Add iirds:relates-to-product-variant on the Document, relating it to the product variant it documents. In a handover the receiving plant files documents against equipment, and this is the link that makes that possible." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  sh:path ( iirds:relates-to-product-variant iirds:has-identity iirds:has-identity-domain iirds:has-identity-type ) ;
  sh:qualifiedValueShape [ sh:in ( iirds:ObjectInstanceURI iirds:ObjectTypeURI iirds:SerialNumber ) ] ;
  sh:qualifiedMinCount 1 .

ivs:M15.7c a sh:NodeShape ;
  rdfs:label "The iirds:ProductVariant MUST relate to another iirds:Identity with an iirds:IdentityDomain that has an iirds:has-identity-type of iirds:ProductType." ;
  sh:severity sh:Violation ;
  sh:message "The iirds:ProductVariant MUST relate to another iirds:Identity with an iirds:IdentityDomain that has an iirds:has-identity-type of iirds:ProductType." ;
  ivm:ruleId "M15.7c" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Relate the ProductVariant to a second iirds:Identity carrying the product type, with its own IdentityDomain. A handover needs both what this machine is and which type it belongs to, because manuals are written per type." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:ProductVariant ;
  sh:property ivs:M15.7c-p .
ivs:M15.7c-p a sh:PropertyShape ;
  sh:message "The iirds:ProductVariant MUST relate to another iirds:Identity with an iirds:IdentityDomain that has an iirds:has-identity-type of iirds:ProductType." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M15.7c" ;
  sh:description "Relate the ProductVariant to a second iirds:Identity carrying the product type, with its own IdentityDomain. A handover needs both what this machine is and which type it belongs to, because manuals are written per type." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  sh:path ( iirds:has-identity iirds:has-identity-domain iirds:has-identity-type ) ;
  sh:qualifiedValueShape [ sh:in ( iirds:ProductType ) ] ;
  sh:qualifiedMinCount 1 .

ivs:M15.8 a sh:NodeShape ;
  rdfs:label "In iiRDS/H each iirds:Document must have at least one iirds:relates-to-Party relating to an iirds:Party with iirds:has-party-role iirds:Author and iirds:relates-to-vcard relating to a vcard:Organization which states vcard:organization-name." ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H each iirds:Document must have at least one iirds:relates-to-Party relating to an iirds:Party with iirds:has-party-role iirds:Author and iirds:relates-to-vcard relating to a vcard:Organization which states vcard:organization-name." ;
  ivm:ruleId "M15.8" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:relates-to-party on the Document, relating it to a Party with a role. A handover document with no responsible organisation leaves the receiving plant with nobody to ask about it." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  ivm:versions "1.3" ;
  sh:targetNode ivs:M15.8 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Document> .
  FILTER NOT EXISTS {
    ?value <http://iirds.tekom.de/iirds#relates-to-party> ?party .
    ?party <http://iirds.tekom.de/iirds#has-party-role> <http://iirds.tekom.de/iirds#Author> .
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?card .
      FILTER NOT EXISTS { ?card ?cp ?co } }
    UNION
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?namedcard .
      ?namedcard <http://www.w3.org/2006/vcard/ns#organization-name> ?orgname }
  } }""" ] .

ivs:M15.9 a sh:NodeShape ;
  rdfs:label "In iiRDS/H each iirds:Package must have at least one iirds:relates-to-Party relating to an iirds:Party with iirds:has-party-role iirds:Creator and iirds:relates-to-vcard relating to a vcard:Organization which states vcard:organization-name." ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H each iirds:Package must have at least one iirds:relates-to-Party relating to an iirds:Party with iirds:has-party-role iirds:Creator and iirds:relates-to-vcard relating to a vcard:Organization which states vcard:organization-name." ;
  ivm:ruleId "M15.9" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:relates-to-party on the Package, relating it to a Party with a role. It names who delivered this consignment, as distinct from who authored any one document inside it." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements> ;
  ivm:versions "1.3" ;
  sh:targetNode ivs:M15.9 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> .
  FILTER NOT EXISTS {
    ?value <http://iirds.tekom.de/iirds#relates-to-party> ?party .
    ?party <http://iirds.tekom.de/iirds#has-party-role> <http://iirds.tekom.de/iirds#Creator> .
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?card .
      FILTER NOT EXISTS { ?card ?cp ?co } }
    UNION
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?namedcard .
      ?namedcard <http://www.w3.org/2006/vcard/ns#organization-name> ?orgname }
  } }""" ] .

ivs:M15.10 a sh:NodeShape ;
  rdfs:label "In iiRDS/H each iirds:InformationObject must have at least one iirds:relates-to-Party relating to an iirds:Party with iirds:has-party-role iirds:Creator and iirds:relates-to-vcard relating to a vcard:Organization which states vcard:organization-name." ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H each iirds:InformationObject must have at least one iirds:relates-to-Party relating to an iirds:Party with iirds:has-party-role iirds:Creator and iirds:relates-to-vcard relating to a vcard:Organization which states vcard:organization-name." ;
  ivm:ruleId "M15.10" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:relates-to-party on the InformationObject, relating it to a Party with a role. Responsibility for the underlying content can differ from responsibility for the delivered document, and a plant needs both." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements> ;
  ivm:versions "1.3" ;
  sh:targetNode ivs:M15.10 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#InformationObject> .
  FILTER NOT EXISTS {
    ?value <http://iirds.tekom.de/iirds#relates-to-party> ?party .
    ?party <http://iirds.tekom.de/iirds#has-party-role> <http://iirds.tekom.de/iirds#Creator> .
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?card .
      FILTER NOT EXISTS { ?card ?cp ?co } }
    UNION
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?namedcard .
      ?namedcard <http://www.w3.org/2006/vcard/ns#organization-name> ?orgname }
  } }""" ] .

ivs:M15.11a a sh:NodeShape ;
  rdfs:label "An iiRDS/H package MUST contain only information units of the subclasses iirds:Document and iirds:Package." ;
  sh:severity sh:Violation ;
  sh:message "An iiRDS/H package MUST contain only information units of the subclasses iirds:Document and iirds:Package." ;
  ivm:ruleId "M15.11a" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Retype the information unit as iirds:Document or iirds:Package, or take it out of the handover package. iiRDS/H deliberately restricts the shapes a receiving system has to understand, and that restriction is the profile's whole value." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#restrictions-regarding-the-use-of-classes-and-instances> ;
  ivm:versions "1.3" ;
  sh:targetNode ivs:M15.11a ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value a ?t . FILTER (?t IN (<http://iirds.tekom.de/iirds#InformationUnit>, <http://iirds.tekom.de/iirds#Topic>, <http://iirds.tekom.de/iirds#Fragment>)) }""" ] .

ivs:M15.7b a sh:NodeShape ;
  rdfs:label "The iirds:IdentityDomain of the Instance Identity (ObjectInstanceURI/ObjectTypeURI/SerialNumber) MUST relate to an iirds:Party with iirds:has-party-role iirds:Manufacturer. This Party MUST relate via iirds:relates-to-vcard to a vcard:Organization which states vcard:organization-name." ;
  sh:severity sh:Violation ;
  sh:message "The iirds:IdentityDomain of the Instance Identity (ObjectInstanceURI/ObjectTypeURI/SerialNumber) MUST relate to an iirds:Party with iirds:has-party-role iirds:Manufacturer. This Party MUST relate via iirds:relates-to-vcard to a vcard:Organization which states vcard:organization-name." ;
  ivm:ruleId "M15.7b" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Give the instance Identity an iirds:IdentityDomain that names one of ObjectInstanceURI, ObjectTypeURI or SerialNumber. The domain says which identifier scheme the value belongs to; without it a serial number and an asset URI are indistinguishable strings." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements> ;
  ivm:versions "1.3" ;
  sh:targetNode ivs:M15.7b ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?variant <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#ProductVariant> .
  ?variant <http://iirds.tekom.de/iirds#has-identity> ?identity .
  ?identity <http://iirds.tekom.de/iirds#has-identity-domain> ?value .
  ?value <http://iirds.tekom.de/iirds#has-identity-type> ?idtype .
  FILTER (?idtype IN (<http://iirds.tekom.de/iirds#ObjectInstanceURI>, <http://iirds.tekom.de/iirds#ObjectTypeURI>, <http://iirds.tekom.de/iirds#SerialNumber>))
  FILTER NOT EXISTS {
    ?value <http://iirds.tekom.de/iirds#relates-to-party> ?party .
    ?party <http://iirds.tekom.de/iirds#has-party-role> <http://iirds.tekom.de/iirds#Manufacturer> .
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?card .
      FILTER NOT EXISTS { ?card ?cp ?co } }
    UNION
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?namedcard .
      ?namedcard <http://www.w3.org/2006/vcard/ns#organization-name> ?orgname }
  } }""" ] .

ivs:M15.7d a sh:NodeShape ;
  rdfs:label "The iirds:IdentityDomain of the ProductType Identity MUST relate to an iirds:Party with iirds:has-party-role iirds:Manufacturer. This Party MUST relate via iirds:relates-to-vcard to a vcard:Organization which states vcard:organization-name." ;
  sh:severity sh:Violation ;
  sh:message "The iirds:IdentityDomain of the ProductType Identity MUST relate to an iirds:Party with iirds:has-party-role iirds:Manufacturer. This Party MUST relate via iirds:relates-to-vcard to a vcard:Organization which states vcard:organization-name." ;
  ivm:ruleId "M15.7d" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Relate the ProductType IdentityDomain to an iirds:Party with iirds:has-party-role. Identifier schemes are only unique within the organisation that issues them, so the domain has to say whose scheme it is." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements> ;
  ivm:versions "1.3" ;
  sh:targetNode ivs:M15.7d ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?variant <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#ProductVariant> .
  ?variant <http://iirds.tekom.de/iirds#has-identity> ?identity .
  ?identity <http://iirds.tekom.de/iirds#has-identity-domain> ?value .
  ?value <http://iirds.tekom.de/iirds#has-identity-type> ?idtype .
  FILTER (?idtype IN (<http://iirds.tekom.de/iirds#ProductType>))
  FILTER NOT EXISTS {
    ?value <http://iirds.tekom.de/iirds#relates-to-party> ?party .
    ?party <http://iirds.tekom.de/iirds#has-party-role> <http://iirds.tekom.de/iirds#Manufacturer> .
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?card .
      FILTER NOT EXISTS { ?card ?cp ?co } }
    UNION
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?namedcard .
      ?namedcard <http://www.w3.org/2006/vcard/ns#organization-name> ?orgname }
  } }""" ] .

ivs:R4 a sh:NodeShape ;
  rdfs:label "a vcard a party points at must be described in the package" ;
  sh:severity sh:Violation ;
  sh:message "a vcard a party points at must be described in the package" ;
  ivm:ruleId "R4" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Describe the vcard in this package as a vcard:Organization carrying a vcard:organization-name, or drop the iirds:relates-to-vcard. A pointer at an IRI nothing here describes leaves the party unidentifiable to a reader holding only the package, which in handover is the reader it is for." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements> ;
  ivm:versions "1.3" ;
  sh:targetNode ivs:R4 ;
  sh:sparql [ sh:select """SELECT DISTINCT $this ?value WHERE {
  ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?value .
  FILTER NOT EXISTS { ?value ?cp ?co } }""" ] .
