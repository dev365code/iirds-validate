ivs:M15.5 a sh:NodeShape ;
  rdfs:label "In iiRDS/H the following metadata is mandatory for each iirds:Document: one iirds:is-version-of relating to an iirds:InformationObject" ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H the following metadata is mandatory for each iirds:Document: one iirds:is-version-of relating to an iirds:InformationObject" ;
  ivm:ruleId "M15.5" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add one iirds:is-version-of relating the Document to an iirds:InformationObject. That link is how a plant recognises a later delivery as a revision of a document it already holds instead of as a new one." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:Document ;
  sh:property ivs:M15.5-p .
ivs:M15.5-p a sh:PropertyShape ;
  sh:message "In iiRDS/H the following metadata is mandatory for each iirds:Document: one iirds:is-version-of relating to an iirds:InformationObject" ;
  sh:severity sh:Violation ;
  ivm:ruleId "M15.5" ;
  sh:description "Add one iirds:is-version-of relating the Document to an iirds:InformationObject. That link is how a plant recognises a later delivery as a revision of a document it already holds instead of as a new one." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  sh:path iirds:is-version-of ;
  sh:qualifiedValueShape [ sh:class iirds:InformationObject ] ;
  sh:qualifiedMinCount 1 ;
  sh:qualifiedMaxCount 1 .

ivs:M15.6 a sh:NodeShape ;
  rdfs:label "In iiRDS/H the following metadata is mandatory for each iirds:Document: iirds:has-rendition" ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H the following metadata is mandatory for each iirds:Document: iirds:has-rendition" ;
  ivm:ruleId "M15.6" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:has-rendition to the Document, pointing at a Rendition whose iirds:source names a file in this container. Without it the metadata describes a document the package does not actually deliver." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:Document ;
  sh:property ivs:M15.6-p .
ivs:M15.6-p a sh:PropertyShape ;
  sh:message "In iiRDS/H the following metadata is mandatory for each iirds:Document: iirds:has-rendition" ;
  sh:severity sh:Violation ;
  ivm:ruleId "M15.6" ;
  sh:description "Add iirds:has-rendition to the Document, pointing at a Rendition whose iirds:source names a file in this container. Without it the metadata describes a document the package does not actually deliver." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  sh:path iirds:has-rendition ;
  sh:minCount 1 .

ivs:M15.11b a sh:NodeShape ;
  rdfs:label "An iiRDS/H package MUST NOT contain instances of iirds:DirectoryNode." ;
  sh:severity sh:Violation ;
  sh:message "An iiRDS/H package MUST NOT contain instances of iirds:DirectoryNode." ;
  ivm:ruleId "M15.11b" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Remove the iirds:DirectoryNode instances. iiRDS/H carries documents, not a navigation tree; a handover package is filed by the receiving system rather than browsed as authored." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#restrictions-regarding-the-use-of-classes-and-instances> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:DirectoryNode, iirds:nil ;
  sh:not [ ] .

ivs:M15.11c a sh:NodeShape ;
  rdfs:label "An iiRDS/H package MUST NOT contain instances of iirds:Selector." ;
  sh:severity sh:Violation ;
  sh:message "An iiRDS/H package MUST NOT contain instances of iirds:Selector." ;
  ivm:ruleId "M15.11c" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Remove the iirds:Selector instances. iiRDS/H delivers whole documents, so addressing a fragment inside one has no meaning on the receiving side." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#restrictions-regarding-the-use-of-classes-and-instances> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:FragmentSelector, iirds:RangeSelector, iirds:Selector ;
  sh:not [ ] .

ivs:M15.7a a sh:NodeShape ;
  rdfs:label "In iiRDS/H each iirds:Document must have at least one iirds:relates-to-product-variant relating to an iirds:ProductVariant. This iirds:ProductVariant MUST relate to an iirds:Identity with an iirds:IdentityDomain that has an iirds:has-identity-type of either iirds:ObjectInstanceURI, iirds:ObjectTypeURI or iirds:SerialNumber." ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H each iirds:Document must have at least one iirds:relates-to-product-variant relating to an iirds:ProductVariant. This iirds:ProductVariant MUST relate to an iirds:Identity with an iirds:IdentityDomain that has an iirds:has-identity-type of either iirds:ObjectInstanceURI, iirds:ObjectTypeURI or iirds:SerialNumber." ;
  ivm:ruleId "M15.7a" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:relates-to-product-variant on the Document, relating it to the product variant it documents. In a handover the receiving plant files documents against equipment, and this is the link that makes that possible." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:Document ;
  sh:property ivs:M15.7a-p1 ;
  sh:property ivs:M15.7a-p2 .
ivs:M15.7a-p1 a sh:PropertyShape ;
  sh:message "In iiRDS/H each iirds:Document must have at least one iirds:relates-to-product-variant relating to an iirds:ProductVariant. This iirds:ProductVariant MUST relate to an iirds:Identity with an iirds:IdentityDomain that has an iirds:has-identity-type of either iirds:ObjectInstanceURI, iirds:ObjectTypeURI or iirds:SerialNumber." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M15.7a" ;
  sh:description "Add iirds:relates-to-product-variant on the Document, relating it to the product variant it documents. In a handover the receiving plant files documents against equipment, and this is the link that makes that possible." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  sh:path iirds:relates-to-product-variant ;
  sh:minCount 1 .
ivs:M15.7a-p2 a sh:PropertyShape ;
  sh:message "In iiRDS/H each iirds:Document must have at least one iirds:relates-to-product-variant relating to an iirds:ProductVariant. This iirds:ProductVariant MUST relate to an iirds:Identity with an iirds:IdentityDomain that has an iirds:has-identity-type of either iirds:ObjectInstanceURI, iirds:ObjectTypeURI or iirds:SerialNumber." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M15.7a" ;
  sh:description "Add iirds:relates-to-product-variant on the Document, relating it to the product variant it documents. In a handover the receiving plant files documents against equipment, and this is the link that makes that possible." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  sh:path ( iirds:relates-to-product-variant iirds:has-identity iirds:has-identity-domain iirds:has-identity-type ) ;
  sh:qualifiedValueShape [ sh:in ( iirds:ObjectInstanceURI iirds:ObjectTypeURI iirds:SerialNumber ) ] ;
  sh:qualifiedMinCount 1 .

ivs:M15.7c a sh:NodeShape ;
  rdfs:label "The iirds:ProductVariant MUST relate to another iirds:Identity with an iirds:IdentityDomain that has an iirds:has-identity-type of iirds:ProductType." ;
  sh:severity sh:Violation ;
  sh:message "The iirds:ProductVariant MUST relate to another iirds:Identity with an iirds:IdentityDomain that has an iirds:has-identity-type of iirds:ProductType." ;
  ivm:ruleId "M15.7c" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Relate the ProductVariant to a second iirds:Identity carrying the product type, with its own IdentityDomain. A handover needs both what this machine is and which type it belongs to, because manuals are written per type." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  ivm:versions "1.3" ;
  sh:targetClass iirds:ProductVariant ;
  sh:property ivs:M15.7c-p .
ivs:M15.7c-p a sh:PropertyShape ;
  sh:message "The iirds:ProductVariant MUST relate to another iirds:Identity with an iirds:IdentityDomain that has an iirds:has-identity-type of iirds:ProductType." ;
  sh:severity sh:Violation ;
  ivm:ruleId "M15.7c" ;
  sh:description "Relate the ProductVariant to a second iirds:Identity carrying the product type, with its own IdentityDomain. A handover needs both what this machine is and which type it belongs to, because manuals are written per type." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  sh:path ( iirds:has-identity iirds:has-identity-domain iirds:has-identity-type ) ;
  sh:qualifiedValueShape [ sh:in ( iirds:ProductType ) ] ;
  sh:qualifiedMinCount 1 .
