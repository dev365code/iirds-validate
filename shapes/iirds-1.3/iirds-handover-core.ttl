  ivm:ruleId "M15.2" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add exactly one iirdsHov:has-document-type to the Document, naming one of the handover document types. In iiRDS/H a receiving plant sorts incoming documents by this before anything reads them." ;
