@prefix ivm:      <https://w3id.org/iirds-validate/shapes/meta#> .

ivs:M15.8 a sh:NodeShape ;
  rdfs:label "In iiRDS/H each iirds:Document must have at least one iirds:relates-to-Party relating to an iirds:Party with iirds:has-party-role iirds:Author and iirds:relates-to-vcard relating to a vcard:Organization which states vcard:organization-name." ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H each iirds:Document must have at least one iirds:relates-to-Party relating to an iirds:Party with iirds:has-party-role iirds:Author and iirds:relates-to-vcard relating to a vcard:Organization which states vcard:organization-name." ;
  ivm:ruleId "M15.8" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:relates-to-party on the Document, relating it to a Party with a role. A handover document with no responsible organisation leaves the receiving plant with nobody to ask about it." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements:~:text=The%20following%20metadata%20is%20mandatory%20for%20each%20iirds%3ADocument%3A> ;
  ivm:versions "1.3" ;
  sh:targetNode ivs:M15.8 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Document> .
  FILTER NOT EXISTS {
    ?value <http://iirds.tekom.de/iirds#relates-to-party> ?party .
    ?party <http://iirds.tekom.de/iirds#has-party-role> <http://iirds.tekom.de/iirds#Author> .
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?card .
      FILTER NOT EXISTS { ?card ?cp ?co } }
    UNION
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?namedcard .
      ?namedcard <http://www.w3.org/2006/vcard/ns#organization-name> ?orgname }
  } }""" ] .

ivs:M15.9 a sh:NodeShape ;
  rdfs:label "In iiRDS/H each iirds:Package must have at least one iirds:relates-to-Party relating to an iirds:Party with iirds:has-party-role iirds:Creator and iirds:relates-to-vcard relating to a vcard:Organization which states vcard:organization-name." ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H each iirds:Package must have at least one iirds:relates-to-Party relating to an iirds:Party with iirds:has-party-role iirds:Creator and iirds:relates-to-vcard relating to a vcard:Organization which states vcard:organization-name." ;
  ivm:ruleId "M15.9" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:relates-to-party on the Package, relating it to a Party with a role. It names who delivered this consignment, as distinct from who authored any one document inside it." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements> ;
  ivm:versions "1.3" ;
  sh:targetNode ivs:M15.9 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> .
  FILTER NOT EXISTS {
    ?value <http://iirds.tekom.de/iirds#relates-to-party> ?party .
    ?party <http://iirds.tekom.de/iirds#has-party-role> <http://iirds.tekom.de/iirds#Creator> .
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?card .
      FILTER NOT EXISTS { ?card ?cp ?co } }
    UNION
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?namedcard .
      ?namedcard <http://www.w3.org/2006/vcard/ns#organization-name> ?orgname }
  } }""" ] .

ivs:M15.10 a sh:NodeShape ;
  rdfs:label "In iiRDS/H each iirds:InformationObject must have at least one iirds:relates-to-Party relating to an iirds:Party with iirds:has-party-role iirds:Creator and iirds:relates-to-vcard relating to a vcard:Organization which states vcard:organization-name." ;
  sh:severity sh:Violation ;
  sh:message "In iiRDS/H each iirds:InformationObject must have at least one iirds:relates-to-Party relating to an iirds:Party with iirds:has-party-role iirds:Creator and iirds:relates-to-vcard relating to a vcard:Organization which states vcard:organization-name." ;
  ivm:ruleId "M15.10" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add iirds:relates-to-party on the InformationObject, relating it to a Party with a role. Responsibility for the underlying content can differ from responsibility for the delivered document, and a plant needs both." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements> ;
  ivm:versions "1.3" ;
  sh:targetNode ivs:M15.10 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#InformationObject> .
  FILTER NOT EXISTS {
    ?value <http://iirds.tekom.de/iirds#relates-to-party> ?party .
    ?party <http://iirds.tekom.de/iirds#has-party-role> <http://iirds.tekom.de/iirds#Creator> .
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?card .
      FILTER NOT EXISTS { ?card ?cp ?co } }
    UNION
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?namedcard .
      ?namedcard <http://www.w3.org/2006/vcard/ns#organization-name> ?orgname }
  } }""" ] .

ivs:M15.11a a sh:NodeShape ;
  rdfs:label "An iiRDS/H package MUST contain only information units of the subclasses iirds:Document and iirds:Package." ;
  sh:severity sh:Violation ;
  sh:message "An iiRDS/H package MUST contain only information units of the subclasses iirds:Document and iirds:Package." ;
  ivm:ruleId "M15.11a" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Retype the information unit as iirds:Document or iirds:Package, or take it out of the handover package. iiRDS/H deliberately restricts the shapes a receiving system has to understand, and that restriction is the profile's whole value." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#restrictions-regarding-the-use-of-classes-and-instances> ;
  ivm:versions "1.3" ;
  sh:targetNode ivs:M15.11a ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value a ?t . FILTER (?t IN (<http://iirds.tekom.de/iirds#InformationUnit>, <http://iirds.tekom.de/iirds#Topic>, <http://iirds.tekom.de/iirds#Fragment>)) }""" ] .

ivs:M15.7b a sh:NodeShape ;
  rdfs:label "The iirds:IdentityDomain of the Instance Identity (ObjectInstanceURI/ObjectTypeURI/SerialNumber) MUST relate to an iirds:Party with iirds:has-party-role iirds:Manufacturer. This Party MUST relate via iirds:relates-to-vcard to a vcard:Organization which states vcard:organization-name." ;
  sh:severity sh:Violation ;
  sh:message "The iirds:IdentityDomain of the Instance Identity (ObjectInstanceURI/ObjectTypeURI/SerialNumber) MUST relate to an iirds:Party with iirds:has-party-role iirds:Manufacturer. This Party MUST relate via iirds:relates-to-vcard to a vcard:Organization which states vcard:organization-name." ;
  ivm:ruleId "M15.7b" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Give the instance Identity an iirds:IdentityDomain that names one of ObjectInstanceURI, ObjectTypeURI or SerialNumber. The domain says which identifier scheme the value belongs to; without it a serial number and an asset URI are indistinguishable strings." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements> ;
  ivm:versions "1.3" ;
  sh:targetNode ivs:M15.7b ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?variant <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#ProductVariant> .
  ?variant <http://iirds.tekom.de/iirds#has-identity> ?identity .
  ?identity <http://iirds.tekom.de/iirds#has-identity-domain> ?value .
  ?value <http://iirds.tekom.de/iirds#has-identity-type> ?idtype .
  FILTER (?idtype IN (<http://iirds.tekom.de/iirds#ObjectInstanceURI>, <http://iirds.tekom.de/iirds#ObjectTypeURI>, <http://iirds.tekom.de/iirds#SerialNumber>))
  FILTER NOT EXISTS {
    ?value <http://iirds.tekom.de/iirds#relates-to-party> ?party .
    ?party <http://iirds.tekom.de/iirds#has-party-role> <http://iirds.tekom.de/iirds#Manufacturer> .
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?card .
      FILTER NOT EXISTS { ?card ?cp ?co } }
    UNION
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?namedcard .
      ?namedcard <http://www.w3.org/2006/vcard/ns#organization-name> ?orgname }
  } }""" ] .

ivs:M15.7d a sh:NodeShape ;
  rdfs:label "The iirds:IdentityDomain of the ProductType Identity MUST relate to an iirds:Party with iirds:has-party-role iirds:Manufacturer. This Party MUST relate via iirds:relates-to-vcard to a vcard:Organization which states vcard:organization-name." ;
  sh:severity sh:Violation ;
  sh:message "The iirds:IdentityDomain of the ProductType Identity MUST relate to an iirds:Party with iirds:has-party-role iirds:Manufacturer. This Party MUST relate via iirds:relates-to-vcard to a vcard:Organization which states vcard:organization-name." ;
  ivm:ruleId "M15.7d" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Relate the ProductType IdentityDomain to an iirds:Party with iirds:has-party-role. Identifier schemes are only unique within the organisation that issues them, so the domain has to say whose scheme it is." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements> ;
  ivm:versions "1.3" ;
  sh:targetNode ivs:M15.7d ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?variant <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#ProductVariant> .
  ?variant <http://iirds.tekom.de/iirds#has-identity> ?identity .
  ?identity <http://iirds.tekom.de/iirds#has-identity-domain> ?value .
  ?value <http://iirds.tekom.de/iirds#has-identity-type> ?idtype .
  FILTER (?idtype IN (<http://iirds.tekom.de/iirds#ProductType>))
  FILTER NOT EXISTS {
    ?value <http://iirds.tekom.de/iirds#relates-to-party> ?party .
    ?party <http://iirds.tekom.de/iirds#has-party-role> <http://iirds.tekom.de/iirds#Manufacturer> .
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?card .
      FILTER NOT EXISTS { ?card ?cp ?co } }
    UNION
    { ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?namedcard .
      ?namedcard <http://www.w3.org/2006/vcard/ns#organization-name> ?orgname }
  } }""" ] .
