<https://iirds.dev/shapes#R61Equivalents> a sh:SPARQLFunction ;
  sh:parameter [ sh:path <https://iirds.dev/shapes#cls> ; sh:order 0 ] ;
  sh:parameter [ sh:path <https://iirds.dev/shapes#seen> ; sh:order 1 ] ;
  sh:returnType <http://www.w3.org/2001/XMLSchema#string> ;
  sh:select """SELECT (IF(CONTAINS(?seen, CONCAT("|", ENCODE_FOR_URI(STR(?cls)), "|")), "",
  CONCAT(?base, COALESCE(?suffix, ""))) AS ?result)
WHERE {
  BIND (IF(CONTAINS("", CONCAT("!", ENCODE_FOR_URI(STR(?cls)), "!")), STRBEFORE(STRAFTER("", CONCAT("!", ENCODE_FOR_URI(STR(?cls)), "!")), "!"), CONCAT("|", ENCODE_FOR_URI(STR(?cls)), "|")) AS ?base)
  { SELECT (GROUP_CONCAT(?part; separator="") AS ?suffix) WHERE {
    { SELECT (SAMPLE(?step) AS ?child) (SAMPLE(?newSeen) AS ?visited) WHERE {
      BIND (IF(CONTAINS("", CONCAT("!", ENCODE_FOR_URI(STR(?cls)), "!")), STRBEFORE(STRAFTER("", CONCAT("!", ENCODE_FOR_URI(STR(?cls)), "!")), "!"), CONCAT("|", ENCODE_FOR_URI(STR(?cls)), "|")) AS ?localBase)
      ?source (<http://www.w3.org/2002/07/owl#equivalentClass>|^<http://www.w3.org/2002/07/owl#equivalentClass>) ?step .
      FILTER (CONTAINS(?localBase, CONCAT("|", ENCODE_FOR_URI(STR(?source)), "|")))
      FILTER (!CONTAINS(?seen, CONCAT("|", ENCODE_FOR_URI(STR(?cls)), "|")))
      BIND (CONCAT(?seen, ?localBase) AS ?newSeen)
    } GROUP BY ?step }
    BIND (<https://iirds.dev/shapes#R61Equivalents>(?child, ?visited) AS ?part)
  } }
}""" .

