# Convention: validate metadata parsed against base <urn:iirds:package:>.

@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix iirds:    <http://iirds.tekom.de/iirds#> .
@prefix iirdsHov: <http://iirds.tekom.de/iirds/domain/handover#> .
@prefix mach:     <http://iirds.tekom.de/iirds/domain/machinery#> .
@prefix sw:       <http://iirds.tekom.de/iirds/domain/software#> .
@prefix ivs:      <https://w3id.org/iirds-validate/shapes#> .
@prefix ivm:      <https://w3id.org/iirds-validate/shapes/meta#> .

ivs:L10 a sh:NodeShape ;
  rdfs:label "abstract iiRDS classes should not be used to type an instance directly" ;
  sh:severity sh:Warning ;
  sh:message "abstract iiRDS classes should not be used to type an instance directly" ;
  ivm:ruleId "L10" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Retype the instance as one of the subclasses. The grouping class says only that something of that family is involved, which leaves a consumer nothing to act on." ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetNode ivs:L10 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE { ?value a ?t . FILTER (?t IN (<http://iirds.tekom.de/iirds#AdministrativeMetadata>, <http://iirds.tekom.de/iirds#AfterUse>, <http://iirds.tekom.de/iirds#Collection>, <http://iirds.tekom.de/iirds#Conformity>, <http://iirds.tekom.de/iirds#DesignAndRealization>, <http://iirds.tekom.de/iirds#DocumentationMetadata>, <http://iirds.tekom.de/iirds#ForeseeableMisuse>, <http://iirds.tekom.de/iirds#FunctionalMetadata>, <http://iirds.tekom.de/iirds#InformationSubject>, <http://iirds.tekom.de/iirds#InformationType>, <http://iirds.tekom.de/iirds#InformationUnit>, <http://iirds.tekom.de/iirds#PlanningTime>, <http://iirds.tekom.de/iirds#ProductFeature>, <http://iirds.tekom.de/iirds#ProductLifeCyclePhase>, <http://iirds.tekom.de/iirds#ProductMetadata>, <http://iirds.tekom.de/iirds#PuttingToUse>, <http://iirds.tekom.de/iirds#Qualification>, <http://iirds.tekom.de/iirds#Safety>, <http://iirds.tekom.de/iirds#Supply>, <http://iirds.tekom.de/iirds#TechnicalData>, <http://iirds.tekom.de/iirds#Use>, <http://iirds.tekom.de/iirds#has-information-type>, <http://iirds.tekom.de/iirds#iirdsAttribute>, <http://iirds.tekom.de/iirds#iirdsDomainEntity>, <http://iirds.tekom.de/iirds#relates-to-action>, <http://iirds.tekom.de/iirds#relates-to-administrative-metadata>)) }""" ] .

ivs:M1 a sh:NodeShape ;
  rdfs:label "iiRDS Generators MUST NOT use the iirds:InformationUnit class directly but MUST use one of the subclasses" ;
  sh:severity sh:Violation ;
  sh:message "iiRDS Generators MUST NOT use the iirds:InformationUnit class directly but MUST use one of the subclasses" ;
  ivm:ruleId "M1" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Retype the instance as one of the InformationUnit subclasses: Topic, Fragment, Document or Package. The parent class says only that something informational is here, which a consumer cannot route, index or display." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#iirds-package-and-container:~:text=iiRDS%20Generators%20MUST%20NOT%20use%20the%20iirds%3AInformationUnit%20class%20directly%20but%20MUST%20use%20one%20of%20the%20subclasses.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-2-information-units#1" ;
  ivm:covers "x6-2-information-units#2" ;
  sh:targetNode ivs:M1 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE { ?value a <http://iirds.tekom.de/iirds#InformationUnit> }""" ] .

ivs:M3 a sh:NodeShape ;
  rdfs:label "Each iiRDS package MUST have exactly one corresponding iirds:Package instance in the metadata." ;
  sh:severity sh:Violation ;
  sh:message "Each iiRDS package MUST have exactly one corresponding iirds:Package instance in the metadata." ;
  ivm:ruleId "M3" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Provide exactly one iirds:Package instance describing this container. It is the root a consumer starts from, so zero leaves the package unidentified and two leave it ambiguous." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#nested-iirds-packages:~:text=Each%20iiRDS%20package%20MUST%20have%20exactly%20one%20corresponding%20iirds%3APackage%20instance%20in%20the%20metadata.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-2-information-units#5" ;
  sh:targetNode ivs:M3 ;
  sh:sparql [ sh:select """SELECT $this WHERE {
  FILTER NOT EXISTS { ?p <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> } }""" ] ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> .
  FILTER NOT EXISTS { ?value <http://iirds.tekom.de/iirds#is-part-of-package> ?x1 .
                      ?x1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> .
                      FILTER (!sameTerm(?x1, ?value)) }
  ?p2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> .
  FILTER NOT EXISTS { ?p2 <http://iirds.tekom.de/iirds#is-part-of-package> ?x2 .
                      ?x2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> .
                      FILTER (!sameTerm(?x2, ?p2)) }
  FILTER (?value != ?p2) }""" ] .

ivs:M5 a sh:NodeShape ;
  rdfs:label "It is RECOMMENDED to use absolute IRIs in rdf:about." ;
  sh:severity sh:Warning ;
  sh:message "It is RECOMMENDED to use absolute IRIs in rdf:about." ;
  ivm:ruleId "M5" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Use an absolute IRI in rdf:about, such as a urn:uuid: or a URL under a domain you control. Relative IRIs resolve against a base that changes when the package is merged into a larger set, so identifiers silently collide. RECOMMENDED, not required." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=It%20is%20RECOMMENDED%20to%20use%20absolute%20IRIs%20in%20rdf%3Aabout.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetNode ivs:M5 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value a ?t . FILTER (STRSTARTS(STR(?t), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?t), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?t), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?t), "http://iirds.tekom.de/iirds/domain/software#"))
  FILTER isIRI(?value)
  FILTER (!REGEX(STR(?value), "^[A-Za-z][A-Za-z0-9+.-]*:")
          || STR(?value) = "urn:iirds:package:") }""" ] .

ivs:M12 a sh:NodeShape ;
  rdfs:label "iirds:Rendition MUST NOT directly use iirds:Selector but MUST use one of its subclasses to reference parts of a file. The class iirds:Selector has the following subclasses: iirds:FragmentSelector; iirds:RangeSelector" ;
  sh:severity sh:Violation ;
  sh:message "iirds:Rendition MUST NOT directly use iirds:Selector but MUST use one of its subclasses to reference parts of a file. The class iirds:Selector has the following subclasses: iirds:FragmentSelector; iirds:RangeSelector" ;
  ivm:ruleId "M12" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Use one of the Selector subclasses instead: FragmentSelector, RangeSelector or one of the others. The base class does not say how to address the part, so a consumer cannot resolve it." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#x-conformance:~:text=iirds%3ARendition%20MUST%20NOT,an%20end%20identifier> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-3-1-reference-part-of-file-by-selector#1" ;
  ivm:covers "x6-3-1-reference-part-of-file-by-selector#2" ;
  sh:targetNode ivs:M12 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE { ?value a <http://iirds.tekom.de/iirds#Selector> }""" ] .

ivs:M16.3 a sh:NodeShape ;
  rdfs:label "An extension of iirds:Event MUST be defined as a class." ;
  sh:severity sh:Violation ;
  sh:message "An extension of iirds:Event MUST be defined as a class." ;
  ivm:ruleId "M16.3" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Declare the extension as a class with rdfs:subClassOf pointing at iirds:Event. Adding an instance of an undeclared type gives a consumer nothing to fall back on." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#adding-a-proprietary-class:~:text=7.3.2-,Adding%20a%20Proprietary%20Class,-Proprietary%20iiRDS%20extensions> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetNode ivs:M16.3 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://iirds.tekom.de/iirds#Event> .
  FILTER (!(STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#")))
  FILTER NOT EXISTS { ?value a <http://www.w3.org/2000/01/rdf-schema#Class> } }""" ] .

ivs:M17 a sh:NodeShape ;
  rdfs:label "An iiRDS package MUST NOT use an external product ontology directly. If an external product ontology is available and used in the iiRDS package, then the iiRDS package MUST also contain metadata labels as instances of iirds:Component." ;
  sh:severity sh:Violation ;
  sh:message "An iiRDS package MUST NOT use an external product ontology directly. If an external product ontology is available and used in the iiRDS package, then the iiRDS package MUST also contain metadata labels as instances of iirds:Component." ;
  ivm:ruleId "M17" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Relate your product entities to iirds:ProductVariant rather than typing them with an external product ontology alone. iiRDS consumers know the iiRDS classes; the external vocabulary can stay alongside as an equivalence." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iiRDS%20package%20MUST%20NOT%20use%20an%20external%20product%20ontology%20directly.%20If%20an%20external%20product%20ontology%20is%20available%20and%20used%20in%20the%20iiRDS%20package%2C%20then%20the%20iiRDS%20package%20MUST%20also%20contain%20metadata%20labels%20as%20instances%20of%20iirds%3AComponent.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-7-2-external-product-ontology#6" ;
  sh:targetNode ivs:M17 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://iirds.tekom.de/iirds#relates-to-component> ?o .
  FILTER NOT EXISTS { ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Component> } }""" ] .

ivs:M18 a sh:NodeShape ;
  rdfs:label "iiRDS provides the class iirds:ProductVariant for extending the iiRDS vocabulary and adding proprietary product variants. As product variants are a proprietary iiRDS extension, they MUST be present in the metadata.rdf of the iiRDS package." ;
  sh:severity sh:Violation ;
  sh:message "iiRDS provides the class iirds:ProductVariant for extending the iiRDS vocabulary and adding proprietary product variants. As product variants are a proprietary iiRDS extension, they MUST be present in the metadata.rdf of the iiRDS package." ;
  ivm:ruleId "M18" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add proprietary product classes as subclasses of iirds:ProductVariant. That way a consumer with no knowledge of your vocabulary still recognises the instances as product variants." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=iiRDS%20provides%20the%20class%20iirds%3AProductVariant%20for%20extending%20the%20iiRDS%20vocabulary%20and%20adding%20proprietary%20product%20variants.%20As%20product%20variants%20are%20a%20proprietary%20iiRDS%20extension%2C%20they%20MUST%20be%20present%20in%20the%20metadata.rdf%20of%20the%20iiRDS%20package.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-7-4-product-variants#1" ;
  sh:targetNode ivs:M18 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://iirds.tekom.de/iirds#relates-to-product-variant> ?o .
  FILTER NOT EXISTS { ?v <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#ProductVariant> } }""" ] .

ivs:M19.4 a sh:NodeShape ;
  rdfs:label "The domain MUST be an instance of the iirdsIdentityDomain class." ;
  sh:severity sh:Violation ;
  sh:message "The domain MUST be an instance of the iirdsIdentityDomain class." ;
  ivm:ruleId "M19.4" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Type the target of iirds:has-identity-domain as iirds:IdentityDomain. Pointing at something else leaves a consumer unable to tell which scheme the identifier is in." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AIdentity%20instance%20consists,of%20the%20iirdsIdentityDomain%20class.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetSubjectsOf iirds:has-identity-domain ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#has-identity-domain> ?value .
  FILTER EXISTS { ?value ?p2 ?o2 }
  FILTER NOT EXISTS {
    ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#IdentityDomain> } }""" ] .

ivs:M22.2 a sh:NodeShape ;
  rdfs:label "An iirds:Party MUST have a related iirds:PartyRole that is assigned by the property iirds:has-party-role, such as author, supplier or manufacturer." ;
  sh:severity sh:Violation ;
  sh:message "An iirds:Party MUST have a related iirds:PartyRole that is assigned by the property iirds:has-party-role, such as author, supplier or manufacturer." ;
  ivm:ruleId "M22.2" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Point iirds:has-party-role at an instance of iirds:PartyRole or one of its subclasses. Pointing at anything else — a vCard, a plain resource — leaves the role unstated even though the property is present." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AParty%20MUST%20have%20a%20related%20iirds%3APartyRole%20that%20is%20assigned%20by%20the%20property%20iirds%3Ahas%2Dparty%2Drole%2C%20such%20as%20author%2C%20supplier%20or%20manufacturer.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-8-3-parties-and-roles#2" ;
  sh:targetSubjectsOf iirds:has-party-role ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#has-party-role> ?value .
  FILTER EXISTS { ?value ?p2 ?o2 }
  FILTER NOT EXISTS { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#PartyRole> }
  FILTER (?value NOT IN (<http://iirds.tekom.de/iirds#Acquisition>, <http://iirds.tekom.de/iirds#Action>, <http://iirds.tekom.de/iirds#AdministrativeMetadata>, <http://iirds.tekom.de/iirds#AdministratorGuide>, <http://iirds.tekom.de/iirds#AfterUse>, <http://iirds.tekom.de/iirds#ApplicableStandards>, <http://iirds.tekom.de/iirds#Approved>, <http://iirds.tekom.de/iirds#ArticleCode>, <http://iirds.tekom.de/iirds#AssemblyInstructions>, <http://iirds.tekom.de/iirds#Author>, <http://iirds.tekom.de/iirds#BillOfMaterials>, <http://iirds.tekom.de/iirds#CDD>, <http://iirds.tekom.de/iirds#CEDeclarationOfConformity>, <http://iirds.tekom.de/iirds#Caution>, <http://iirds.tekom.de/iirds#Certificate>, <http://iirds.tekom.de/iirds#ClassificationDomain>, <http://iirds.tekom.de/iirds#ClassificationType>, <http://iirds.tekom.de/iirds#Collection>, <http://iirds.tekom.de/iirds#Component>, <http://iirds.tekom.de/iirds#Concept>, <http://iirds.tekom.de/iirds#Configuration>, <http://iirds.tekom.de/iirds#Conformity>, <http://iirds.tekom.de/iirds#ContactInformation>, <http://iirds.tekom.de/iirds#ContentLifeCycleStatus>, <http://iirds.tekom.de/iirds#ContentLifeCycleStatusValue>, <http://iirds.tekom.de/iirds#ContractualDocument>, <http://iirds.tekom.de/iirds#Contributor>, <http://iirds.tekom.de/iirds#Creator>, <http://iirds.tekom.de/iirds#Customer>, <http://iirds.tekom.de/iirds#DCC>, <http://iirds.tekom.de/iirds#Danger>, <http://iirds.tekom.de/iirds#DeclarationOfConformity>, <http://iirds.tekom.de/iirds#Decommissioning>, <http://iirds.tekom.de/iirds#Deleted>, <http://iirds.tekom.de/iirds#Design>, <http://iirds.tekom.de/iirds#DesignAndRealization>, <http://iirds.tekom.de/iirds#Development>, <http://iirds.tekom.de/iirds#Diagnostics>, <http://iirds.tekom.de/iirds#DirectoryNode>, <http://iirds.tekom.de/iirds#DirectoryNodeType>, <http://iirds.tekom.de/iirds#Disposal>, <http://iirds.tekom.de/iirds#Document>, <http://iirds.tekom.de/iirds#DocumentType>, <http://iirds.tekom.de/iirds#DocumentationMetadata