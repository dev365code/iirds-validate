ivs:M24.6 a sh:NodeShape ;
  rdfs:label "There MUST be at least one root node that has the elements iirds:has-directory-structure-type, iirds:has-first-child and iirds:has-next-sibling and is not itself referenced as iirds:next-sibling or iirds:first-child." ;
  sh:severity sh:Violation ;
  sh:message "There MUST be at least one root node that has the elements iirds:has-directory-structure-type, iirds:has-first-child and iirds:has-next-sibling and is not itself referenced as iirds:next-sibling or iirds:first-child." ;
  ivm:ruleId "M24.6" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Give the package at least one root node carrying iirds:has-directory-structure-type together with its first child. Without a root there is no entry point, and the whole structure is unreachable." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=6.9.1-,Directory%20Nodes> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetNode ivs:M24.6 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?nt .
  FILTER (?nt IN (<http://iirds.tekom.de/iirds#DirectoryNode>, <http://iirds.tekom.de/iirds#nil>))
  FILTER NOT EXISTS { ?root <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?rt .
      FILTER (?rt IN (<http://iirds.tekom.de/iirds#DirectoryNode>, <http://iirds.tekom.de/iirds#nil>))
      ?root <http://iirds.tekom.de/iirds#has-directory-structure-type> ?t ; <http://iirds.tekom.de/iirds#has-first-child> ?c } }""" ] .

ivs:M30 a sh:NodeShape ;
  rdfs:label "The file metadata.rdf MUST NOT contain the iiRDS schema or iiRDS domain extensions." ;
  sh:severity sh:Violation ;
  sh:message "The file metadata.rdf MUST NOT contain the iiRDS schema or iiRDS domain extensions." ;
  ivm:ruleId "M30" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Remove the statement. It restates a relationship the iiRDS ontology already defines, which bloats every package and lets a stale copy contradict the real one. Linking your own class to an iiRDS class is a different thing and is allowed." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=The%20file%20metadata.rdf%20MUST%20NOT%20contain%20the%20iiRDS%20schema%20or%20iiRDS%20domain%20extensions.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x7-1-iirds-extension-scenarios#5" ;
  sh:targetNode ivs:M30 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  { ?value a <http://www.w3.org/2000/01/rdf-schema#Class> } UNION { ?value a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> }
  UNION { ?value ?p ?o .
          FILTER (?p IN (<http://www.w3.org/2000/01/rdf-schema#subClassOf>, <http://www.w3.org/2000/01/rdf-schema#subPropertyOf>,
                         <http://www.w3.org/2000/01/rdf-schema#domain>, <http://www.w3.org/2000/01/rdf-schema#range>))
          FILTER (STRSTARTS(STR(?o), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?o), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?o), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?o), "http://iirds.tekom.de/iirds/domain/software#")) }
  FILTER (STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#")) }""" ] .

ivs:S4 a sh:NodeShape ;
  rdfs:label "iirds:iiRDSVersion must name a published version of the standard" ;
  sh:severity sh:Violation ;
  sh:message "iirds:iiRDSVersion must name a published version of the standard" ;
  ivm:ruleId "S4" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Set iirds:iiRDSVersion to a version the standard has published: 1.0, 1.0.1, 1.1, 1.2 or 1.3. A version nobody published cannot be validated against, and rounding it up would silently check the wrong rules." ;
  sh:targetSubjectsOf iirds:iiRDSVersion ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#iiRDSVersion> ?value .
  FILTER (!REGEX(STR(?value), "^\\\\s*(1[.]0|1[.]0[.]1|1[.]1|1[.]2|1[.]3)\\\\s*$")) }""" ] .

ivs:S5 a sh:NodeShape ;
  rdfs:label "iirds:formatRestriction must name a published profile" ;
  sh:severity sh:Violation ;
  sh:message "iirds:formatRestriction must name a published profile" ;
  ivm:ruleId "S5" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Set iirds:formatRestriction to a published profile, or remove the property to mean the unrestricted one. A value matching no profile would otherwise switch off both rule sets at once." ;
  sh:targetSubjectsOf iirds:formatRestriction ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#formatRestriction> ?value .
  FILTER (!REGEX(STR(?value), "^\\\\s*(A|H)?\\\\s*$")) }""" ] .
