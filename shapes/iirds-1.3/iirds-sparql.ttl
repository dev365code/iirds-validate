# THIRD-PARTY-NOTICES.md. Remedy texts are this project's own.
# Convention: validate metadata parsed against base <urn:iirds:package:>.

@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix iirds:    <http://iirds.tekom.de/iirds#> .
@prefix iirdsHov: <http://iirds.tekom.de/iirds/domain/handover#> .
@prefix mach:     <http://iirds.tekom.de/iirds/domain/machinery#> .
@prefix sw:       <http://iirds.tekom.de/iirds/domain/software#> .
@prefix ivs:      <https://w3id.org/iirds-validate/shapes#> .
@prefix ivm:      <https://w3id.org/iirds-validate/shapes/meta#> .

ivs:L10 a sh:NodeShape ;
  rdfs:label "abstract iiRDS classes should not be used to type an instance directly" ;
  sh:severity sh:Warning ;
  sh:message "abstract iiRDS classes should not be used to type an instance directly" ;
  ivm:ruleId "L10" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Retype the instance as one of the subclasses. The grouping class says only that something of that family is involved, which leaves a consumer nothing to act on." ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetNode ivs:L10 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE { ?value a ?t . FILTER (?t IN (<http://iirds.tekom.de/iirds#AdministrativeMetadata>, <http://iirds.tekom.de/iirds#AfterUse>, <http://iirds.tekom.de/iirds#Collection>, <http://iirds.tekom.de/iirds#Conformity>, <http://iirds.tekom.de/iirds#DesignAndRealization>, <http://iirds.tekom.de/iirds#DocumentationMetadata>, <http://iirds.tekom.de/iirds#FunctionalMetadata>, <http://iirds.tekom.de/iirds#InformationSubject>, <http://iirds.tekom.de/iirds#InformationType>, <http://iirds.tekom.de/iirds#InformationUnit>, <http://iirds.tekom.de/iirds#PlanningTime>, <http://iirds.tekom.de/iirds#ProductFeature>, <http://iirds.tekom.de/iirds#ProductLifeCyclePhase>, <http://iirds.tekom.de/iirds#ProductMetadata>, <http://iirds.tekom.de/iirds#PuttingToUse>, <http://iirds.tekom.de/iirds#Qualification>, <http://iirds.tekom.de/iirds#Safety>, <http://iirds.tekom.de/iirds#Supply>, <http://iirds.tekom.de/iirds#TechnicalData>, <http://iirds.tekom.de/iirds#Use>, <http://iirds.tekom.de/iirds#has-information-type>, <http://iirds.tekom.de/iirds#iirdsAttribute>, <http://iirds.tekom.de/iirds#iirdsDomainEntity>, <http://iirds.tekom.de/iirds#iirdsRelationConcept>, <http://iirds.tekom.de/iirds#relates-to-action>, <http://iirds.tekom.de/iirds#relates-to-administrative-metadata>, <http://iirds.tekom.de/iirds#relates-to-functional-metadata>)) }""" ] .

ivs:M1 a sh:NodeShape ;
  rdfs:label "iiRDS Generators MUST NOT use the iirds:InformationUnit class directly but MUST use one of the subclasses" ;
  sh:severity sh:Violation ;
  sh:message "iiRDS Generators MUST NOT use the iirds:InformationUnit class directly but MUST use one of the subclasses" ;
  ivm:ruleId "M1" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Retype the instance as one of the InformationUnit subclasses: Topic, Fragment, Document or Package. The parent class says only that something informational is here, which a consumer cannot route, index or display." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#iirds-package-and-container:~:text=iiRDS%20Generators%20MUST%20NOT%20use%20the%20iirds%3AInformationUnit%20class%20directly%20but%20MUST%20use%20one%20of%20the%20subclasses.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-2-information-units#1" ;
  ivm:covers "x6-2-information-units#2" ;
  sh:targetNode ivs:M1 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE { ?value a <http://iirds.tekom.de/iirds#InformationUnit> }""" ] .

ivs:M3 a sh:NodeShape ;
  rdfs:label "Each iiRDS package MUST have exactly one corresponding iirds:Package instance in the metadata." ;
  sh:severity sh:Violation ;
  sh:message "Each iiRDS package MUST have exactly one corresponding iirds:Package instance in the metadata." ;
  ivm:ruleId "M3" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Provide exactly one iirds:Package instance describing this container. It is the root a consumer starts from, so zero leaves the package unidentified and two leave it ambiguous." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#nested-iirds-packages:~:text=Each%20iiRDS%20package%20MUST%20have%20exactly%20one%20corresponding%20iirds%3APackage%20instance%20in%20the%20metadata.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-2-information-units#5" ;
  sh:targetNode ivs:M3 ;
  sh:sparql [ sh:select """SELECT $this WHERE {
  FILTER NOT EXISTS { ?p <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> } }""" ] ;
  sh:sparql [ sh:select """SELECT $this WHERE {
  ?p <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> .
  FILTER NOT EXISTS {
    ?q <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> .
    FILTER NOT EXISTS { ?q <http://iirds.tekom.de/iirds#is-part-of-package> ?x .
                        ?x <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> .
                        FILTER (!sameTerm(?x, ?q)) } } }""" ] ;
  sh:sparql [ sh:select """SELECT $this WHERE {
  ?own <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> .
  FILTER NOT EXISTS { ?own <http://iirds.tekom.de/iirds#is-part-of-package> ?x1 .
                      ?x1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> .
                      FILTER (!sameTerm(?x1, ?own)) }
  ?p2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> .
  FILTER NOT EXISTS { ?p2 <http://iirds.tekom.de/iirds#is-part-of-package> ?x2 .
                      ?x2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Package> .
                      FILTER (!sameTerm(?x2, ?p2)) }
  FILTER (?own != ?p2) }""" ] .

ivs:M5 a sh:NodeShape ;
  rdfs:label "It is RECOMMENDED to use absolute IRIs in rdf:about." ;
  sh:severity sh:Warning ;
  sh:message "It is RECOMMENDED to use absolute IRIs in rdf:about." ;
  ivm:ruleId "M5" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Use an absolute IRI in rdf:about, such as a urn:uuid: or a URL under a domain you control. Relative IRIs resolve against a base that changes when the package is merged into a larger set, so identifiers silently collide. Section 6.2.1 recommends this; sections 6.2.2, 6.8.1 and 6.8.4 require it of information objects, identity domains and classification domains, which R34 to R36 report separately." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=It%20is%20RECOMMENDED%20to%20use%20absolute%20IRIs%20in%20rdf%3Aabout.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetNode ivs:M5 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value a ?t . FILTER (STRSTARTS(STR(?t), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?t), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?t), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?t), "http://iirds.tekom.de/iirds/domain/software#"))
  FILTER isIRI(?value)
  FILTER (!REGEX(STR(?value), "^[A-Za-z][A-Za-z0-9+.-]*:")
          || STR(?value) = "urn:iirds:package:") }""" ] .

ivs:M12 a sh:NodeShape ;
  rdfs:label "iirds:Rendition MUST NOT directly use iirds:Selector but MUST use one of its subclasses to reference parts of a file. The class iirds:Selector has the following subclasses: iirds:FragmentSelector; iirds:RangeSelector" ;
  sh:severity sh:Violation ;
  sh:message "iirds:Rendition MUST NOT directly use iirds:Selector but MUST use one of its subclasses to reference parts of a file. The class iirds:Selector has the following subclasses: iirds:FragmentSelector; iirds:RangeSelector" ;
  ivm:ruleId "M12" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Use one of the Selector subclasses instead: FragmentSelector, RangeSelector or one of the others. The base class does not say how to address the part, so a consumer cannot resolve it." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#x-conformance:~:text=iirds%3ARendition%20MUST%20NOT,an%20end%20identifier> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-3-1-reference-part-of-file-by-selector#1" ;
  ivm:covers "x6-3-1-reference-part-of-file-by-selector#2" ;
  sh:targetNode ivs:M12 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE { ?value a <http://iirds.tekom.de/iirds#Selector> }""" ] .

ivs:M16.3 a sh:NodeShape ;
  rdfs:label "An extension of iirds:Event MUST be defined as a class." ;
  sh:severity sh:Violation ;
  sh:message "An extension of iirds:Event MUST be defined as a class." ;
  ivm:ruleId "M16.3" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Declare the extension as a class with rdfs:subClassOf pointing at iirds:Event. Adding an instance of an undeclared type gives a consumer nothing to fall back on." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#adding-a-proprietary-class:~:text=7.3.2-,Adding%20a%20Proprietary%20Class,-Proprietary%20iiRDS%20extensions> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetNode ivs:M16.3 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://iirds.tekom.de/iirds#Event> .
  FILTER (!(STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#")))
  FILTER NOT EXISTS { ?value a <http://www.w3.org/2000/01/rdf-schema#Class> } }""" ] .

ivs:M17 a sh:NodeShape ;
  rdfs:label "An iiRDS package MUST NOT use an external product ontology directly. If an external product ontology is available and used in the iiRDS package, then the iiRDS package MUST also contain metadata labels as instances of iirds:Component." ;
  sh:severity sh:Violation ;
  sh:message "An iiRDS package MUST NOT use an external product ontology directly. If an external product ontology is available and used in the iiRDS package, then the iiRDS package MUST also contain metadata labels as instances of iirds:Component." ;
  ivm:ruleId "M17" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Relate your product entities to iirds:ProductVariant rather than typing them with an external product ontology alone. iiRDS consumers know the iiRDS classes; the external vocabulary can stay alongside as an equivalence." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iiRDS%20package%20MUST%20NOT%20use%20an%20external%20product%20ontology%20directly.%20If%20an%20external%20product%20ontology%20is%20available%20and%20used%20in%20the%20iiRDS%20package%2C%20then%20the%20iiRDS%20package%20MUST%20also%20contain%20metadata%20labels%20as%20instances%20of%20iirds%3AComponent.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetNode ivs:M17 ;
  sh:sparql [ sh:select """SELECT $this WHERE {
  ?s <http://iirds.tekom.de/iirds#relates-to-component> ?o .
  FILTER NOT EXISTS { ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Component> } }""" ] .

ivs:M18 a sh:NodeShape ;
  rdfs:label "iiRDS provides the class iirds:ProductVariant for extending the iiRDS vocabulary and adding proprietary product variants. As product variants are a proprietary iiRDS extension, they MUST be present in the metadata.rdf of the iiRDS package." ;
  sh:severity sh:Violation ;
  sh:message "iiRDS provides the class iirds:ProductVariant for extending the iiRDS vocabulary and adding proprietary product variants. As product variants are a proprietary iiRDS extension, they MUST be present in the metadata.rdf of the iiRDS package." ;
  ivm:ruleId "M18" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Add proprietary product classes as subclasses of iirds:ProductVariant. That way a consumer with no knowledge of your vocabulary still recognises the instances as product variants." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=iiRDS%20provides%20the%20class%20iirds%3AProductVariant%20for%20extending%20the%20iiRDS%20vocabulary%20and%20adding%20proprietary%20product%20variants.%20As%20product%20variants%20are%20a%20proprietary%20iiRDS%20extension%2C%20they%20MUST%20be%20present%20in%20the%20metadata.rdf%20of%20the%20iiRDS%20package.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetNode ivs:M18 ;
  sh:sparql [ sh:select """SELECT $this WHERE {
  ?s <http://iirds.tekom.de/iirds#relates-to-product-variant> ?o .
  FILTER NOT EXISTS { ?v <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#ProductVariant> } }""" ] .

ivs:M19.4 a sh:NodeShape ;
  rdfs:label "The domain MUST be an instance of the iirdsIdentityDomain class." ;
  sh:severity sh:Violation ;
  sh:message "The domain MUST be an instance of the iirdsIdentityDomain class." ;
  ivm:ruleId "M19.4" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Type the target of iirds:has-identity-domain as iirds:IdentityDomain. Pointing at something else leaves a consumer unable to tell which scheme the identifier is in." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AIdentity%20instance%20consists,of%20the%20iirdsIdentityDomain%20class.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetSubjectsOf iirds:has-identity-domain ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#has-identity-domain> ?value .
  FILTER NOT EXISTS { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#IdentityDomain> }
  FILTER (?value NOT IN ())
  FILTER (isLiteral(?value)
          || EXISTS { ?value ?p2 ?o2 }
          || isBlank(?value)
          || (STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#"))) }""" ] .

ivs:M22.2 a sh:NodeShape ;
  rdfs:label "An iirds:Party MUST have a related iirds:PartyRole that is assigned by the property iirds:has-party-role, such as author, supplier or manufacturer." ;
  sh:severity sh:Violation ;
  sh:message "An iirds:Party MUST have a related iirds:PartyRole that is assigned by the property iirds:has-party-role, such as author, supplier or manufacturer." ;
  ivm:ruleId "M22.2" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Point iirds:has-party-role at an instance of iirds:PartyRole or one of its subclasses. Pointing at anything else — a vCard, a plain resource — leaves the role unstated even though the property is present." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AParty%20MUST%20have%20a%20related%20iirds%3APartyRole%20that%20is%20assigned%20by%20the%20property%20iirds%3Ahas%2Dparty%2Drole%2C%20such%20as%20author%2C%20supplier%20or%20manufacturer.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-8-3-parties-and-roles#2" ;
  sh:targetSubjectsOf iirds:has-party-role ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#has-party-role> ?value .
  FILTER NOT EXISTS { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#PartyRole> }
  FILTER (?value NOT IN (<http://iirds.tekom.de/iirds#Author>, <http://iirds.tekom.de/iirds#Contributor>, <http://iirds.tekom.de/iirds#Creator>, <http://iirds.tekom.de/iirds#Customer>, <http://iirds.tekom.de/iirds#Inspector>, <http://iirds.tekom.de/iirds#Manufacturer>, <http://iirds.tekom.de/iirds#PerformedBy>, <http://iirds.tekom.de/iirds#Supplier>))
  FILTER (isLiteral(?value)
          || EXISTS { ?value ?p2 ?o2 }
          || isBlank(?value)
          || (STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#"))) }""" ] .

ivs:M24.6 a sh:NodeShape ;
  rdfs:label "There MUST be at least one root node that has the elements iirds:has-directory-structure-type, iirds:has-first-child and iirds:has-next-sibling and is not itself referenced as iirds:next-sibling or iirds:first-child." ;
  sh:severity sh:Violation ;
  sh:message "There MUST be at least one root node that has the elements iirds:has-directory-structure-type, iirds:has-first-child and iirds:has-next-sibling and is not itself referenced as iirds:next-sibling or iirds:first-child." ;
  ivm:ruleId "M24.6" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Give the package at least one root node carrying iirds:has-directory-structure-type together with its first child. Without a root there is no entry point, and the whole structure is unreachable." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=6.9.1-,Directory%20Nodes> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetNode ivs:M24.6 ;
  sh:sparql [ sh:select """SELECT $this WHERE {
  ?n <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?nt .
  FILTER (?nt IN (<http://iirds.tekom.de/iirds#DirectoryNode>, <http://iirds.tekom.de/iirds#nil>))
  FILTER NOT EXISTS { ?root <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?rt .
      FILTER (?rt IN (<http://iirds.tekom.de/iirds#DirectoryNode>, <http://iirds.tekom.de/iirds#nil>))
      ?root <http://iirds.tekom.de/iirds#has-directory-structure-type> ?t ; <http://iirds.tekom.de/iirds#has-first-child> ?c } }""" ] .

ivs:M30 a sh:NodeShape ;
  rdfs:label "The file metadata.rdf MUST NOT contain the iiRDS schema or iiRDS domain extensions." ;
  sh:severity sh:Violation ;
  sh:message "The file metadata.rdf MUST NOT contain the iiRDS schema or iiRDS domain extensions." ;
  ivm:ruleId "M30" ;
  ivm:ruleSource "catalogue" ;
  sh:description "Remove the statement. It restates a relationship the iiRDS ontology already defines, which bloats every package and lets a stale copy contradict the real one. Linking your own class to an iiRDS class is a different thing and is allowed." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=The%20file%20metadata.rdf%20MUST%20NOT%20contain%20the%20iiRDS%20schema%20or%20iiRDS%20domain%20extensions.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x7-1-iirds-extension-scenarios#5" ;
  sh:targetNode ivs:M30 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  { ?value a <http://www.w3.org/2000/01/rdf-schema#Class> } UNION { ?value a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> }
  UNION { ?value ?p ?o .
          FILTER (?p IN (<http://www.w3.org/2000/01/rdf-schema#subClassOf>, <http://www.w3.org/2000/01/rdf-schema#subPropertyOf>,
                         <http://www.w3.org/2000/01/rdf-schema#domain>, <http://www.w3.org/2000/01/rdf-schema#range>))
          FILTER (STRSTARTS(STR(?o), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?o), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?o), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?o), "http://iirds.tekom.de/iirds/domain/software#")) }
  FILTER (STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#")) }""" ] .

ivs:R4 a sh:NodeShape ;
  rdfs:label "a vcard a party points at must be described in the package" ;
  sh:severity sh:Violation ;
  sh:message "a vcard a party points at must be described in the package" ;
  ivm:ruleId "R4" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Describe the vcard in this package as a vcard:Organization carrying a vcard:organization-name, or drop the iirds:relates-to-vcard. A pointer at an IRI nothing here describes leaves the party unidentifiable to anyone holding only the package — which in iiRDS/H is the reader the profile is written for, and is why the five named-party MUSTs are MUSTs there." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#metadata-requirements> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x8-3-2-metadata-requirements#9" ;
  ivm:covers "x8-3-2-metadata-requirements#12" ;
  ivm:covers "x8-3-2-metadata-requirements#13" ;
  sh:targetNode ivs:R4 ;
  sh:sparql [ sh:select """SELECT DISTINCT $this ?value WHERE {
  ?party <http://iirds.tekom.de/iirds#relates-to-vcard> ?value .
  FILTER (!isLiteral(?value))
  FILTER (!(STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#")) && !STRSTARTS(STR(?value), "http://www.w3.org/2006/vcard/ns#"))
  FILTER NOT EXISTS { ?value ?cp ?co } }""" ] .

ivs:R10 a sh:NodeShape ;
  rdfs:label "iirds:has-content-lifecycle-status-value must point at a status value" ;
  sh:severity sh:Violation ;
  sh:message "iirds:has-content-lifecycle-status-value must point at a status value" ;
  ivm:ruleId "R10" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Point iirds:has-content-lifecycle-status-value at an instance of iirds:ContentLifeCycleStatusValue or one of its subclasses. Pointing at anything else leaves the status unnamed even though the property is present, and a consumer sorting by lifecycle state has nothing to sort on." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=An%20iirds%3AContentLifecyleStatus%20MUST%20have%20an%20iirds%3AContentLifecyleStatusValue%20which%20is%20assigned%20by%20the%20iirds%3Ahas%2Dcontent%2Dlifecycle%2Dstatus%2Dvalue%20property.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-8-2-content-lifecycle-status#2" ;
  sh:targetSubjectsOf iirds:has-content-lifecycle-status-value ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#has-content-lifecycle-status-value> ?value .
  FILTER NOT EXISTS { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#ContentLifeCycleStatusValue> }
  FILTER (?value NOT IN (<http://iirds.tekom.de/iirds#Approved>, <http://iirds.tekom.de/iirds#Deleted>, <http://iirds.tekom.de/iirds#InPreparation>, <http://iirds.tekom.de/iirds#InReview>, <http://iirds.tekom.de/iirds#Released>, <http://iirds.tekom.de/iirds#Reviewed>, <http://iirds.tekom.de/iirds#Withdrawn>))
  FILTER (isLiteral(?value)
          || EXISTS { ?value ?p2 ?o2 }
          || isBlank(?value)
          || (STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#"))) }""" ] .

ivs:R12 a sh:NodeShape ;
  rdfs:label "iirds:relates-to-vcard must point at a vcard kind" ;
  sh:severity sh:Violation ;
  sh:message "iirds:relates-to-vcard must point at a vcard kind" ;
  ivm:ruleId "R12" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Type the vcard as one of the vCard kinds — vcard:Organization for a firm, vcard:Individual for a person, vcard:Group or vcard:Location — or as a class your package declares beneath one of them. A party pointing at something that is not a vcard tells a consumer an organisation is involved and gives it nothing it can render, export or contact." ;
  sh:description "Write the value as a reference rather than a string. In JSON-LD that is {\"@id\": \"https://example.com/card\"}, or a context entry declaring \"iirds:relates-to-vcard\": {\"@type\": \"@id\"}; in RDF/XML it is rdf:resource. A string is data about the party, not a link a consumer can follow to a vcard." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=In%20addition%20to%20the%20role%2C%20an%20iirds%3AParty%20MUST%20also%20have%20an%20associated%20description%20of%20itself%20as%20compliant%20vcard%3Akind%20object%20which%20is%20assigned%20via%20iirds%3Arelates%2Dto%2Dvcard.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-8-3-parties-and-roles#3" ;
  ivm:covers "x8-3-2-metadata-requirements#9" ;
  ivm:covers "x8-3-2-metadata-requirements#12" ;
  ivm:covers "x8-3-2-metadata-requirements#13" ;
  sh:targetSubjectsOf iirds:relates-to-vcard ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#relates-to-vcard> ?value .
  FILTER NOT EXISTS {
    ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?kind .
    FILTER (?kind IN (<http://www.w3.org/2006/vcard/ns#Group>, <http://www.w3.org/2006/vcard/ns#Individual>, <http://www.w3.org/2006/vcard/ns#Kind>, <http://www.w3.org/2006/vcard/ns#Location>, <http://www.w3.org/2006/vcard/ns#Organization>, <http://www.w3.org/2006/vcard/ns#VCard>, <http://www.w3.org/2006/vcard/ns#organization>)) }
  FILTER (isLiteral(?value)
          || EXISTS { ?value ?p2 ?o2 }
          || (STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#"))
          || STRSTARTS(STR(?value), "http://www.w3.org/2006/vcard/ns#")) }""" ] .

ivs:R19 a sh:NodeShape ;
  rdfs:label "iirds:has-document-type and iirds:is-applicable-for-document-type must point at an iirds:DocumentType" ;
  sh:severity sh:Violation ;
  sh:message "iirds:has-document-type and iirds:is-applicable-for-document-type must point at an iirds:DocumentType" ;
  ivm:ruleId "R19" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Point iirds:has-document-type and iirds:is-applicable-for-document-type at an instance of iirds:DocumentType or one of its subclasses. A document type written as text is not one of the standardised types, and a consumer routing documents by type -- installation, maintenance, spare parts -- cannot route on a string it has no definition for. Until this rule existed, naming the type as text passed where leaving it out failed." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=Instances%20of%20the%20iirds%3ADocument%20class%20MUST%20have%20one%20or%20more%20relations%20to%20one%20of%20the%20standardized%20iirds%3ADocumentTypes%20defined%20in%20iirds%3AInformationType%20%3E%20iirds%3ADocumentType.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetSubjectsOf iirds:has-document-type, iirds:is-applicable-for-document-type ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#has-document-type> ?value .
  FILTER NOT EXISTS { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#DocumentType> }
  FILTER (?value NOT IN (<http://iirds.tekom.de/iirds#AdministratorGuide>, <http://iirds.tekom.de/iirds#AssemblyInstructions>, <http://iirds.tekom.de/iirds#BillOfMaterials>, <http://iirds.tekom.de/iirds#CEDeclarationOfConformity>, <http://iirds.tekom.de/iirds#Certificate>, <http://iirds.tekom.de/iirds#ContractualDocument>, <http://iirds.tekom.de/iirds#ElectronicIdentificationPlate>, <http://iirds.tekom.de/iirds#IdentificationDocument>, <http://iirds.tekom.de/iirds#InstallationInstructions>, <http://iirds.tekom.de/iirds#MaintenanceInstructions>, <http://iirds.tekom.de/iirds#OperatingInstructions>, <http://iirds.tekom.de/iirds#PartsCatalog>, <http://iirds.tekom.de/iirds#Plan>, <http://iirds.tekom.de/iirds#QuickGuide>, <http://iirds.tekom.de/iirds#RepairInstructions>, <http://iirds.tekom.de/iirds#SafetyInstructions>, <http://iirds.tekom.de/iirds#SalesCatalog>, <http://iirds.tekom.de/iirds#Specification>, <http://iirds.tekom.de/iirds#TechnicalDrawingDiagram>, <http://iirds.tekom.de/iirds#TransportInstructions>))
  FILTER (isLiteral(?value)
          || EXISTS { ?value ?p2 ?o2 }
          || isBlank(?value)
          || (STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#"))) }""" ] ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#is-applicable-for-document-type> ?value .
  FILTER NOT EXISTS { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#DocumentType> }
  FILTER (?value NOT IN (<http://iirds.tekom.de/iirds#AdministratorGuide>, <http://iirds.tekom.de/iirds#AssemblyInstructions>, <http://iirds.tekom.de/iirds#BillOfMaterials>, <http://iirds.tekom.de/iirds#CEDeclarationOfConformity>, <http://iirds.tekom.de/iirds#Certificate>, <http://iirds.tekom.de/iirds#ContractualDocument>, <http://iirds.tekom.de/iirds#ElectronicIdentificationPlate>, <http://iirds.tekom.de/iirds#IdentificationDocument>, <http://iirds.tekom.de/iirds#InstallationInstructions>, <http://iirds.tekom.de/iirds#MaintenanceInstructions>, <http://iirds.tekom.de/iirds#OperatingInstructions>, <http://iirds.tekom.de/iirds#PartsCatalog>, <http://iirds.tekom.de/iirds#Plan>, <http://iirds.tekom.de/iirds#QuickGuide>, <http://iirds.tekom.de/iirds#RepairInstructions>, <http://iirds.tekom.de/iirds#SafetyInstructions>, <http://iirds.tekom.de/iirds#SalesCatalog>, <http://iirds.tekom.de/iirds#Specification>, <http://iirds.tekom.de/iirds#TechnicalDrawingDiagram>, <http://iirds.tekom.de/iirds#TransportInstructions>))
  FILTER (isLiteral(?value)
          || EXISTS { ?value ?p2 ?o2 }
          || isBlank(?value)
          || (STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#"))) }""" ] .

ivs:R20 a sh:NodeShape ;
  rdfs:label "iirds:has-start-selector must point at an iirds:FragmentSelector" ;
  sh:severity sh:Violation ;
  sh:message "iirds:has-start-selector must point at an iirds:FragmentSelector" ;
  ivm:ruleId "R20" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Point iirds:has-start-selector at an instance of iirds:FragmentSelector or one of its subclasses. A range with a start that is not a fragment selector names no position in the file, so the range cannot be resolved even though both ends are present." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=The%20iirds%3ARangeSelector%20points,end%2Dselector.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetSubjectsOf iirds:has-start-selector ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#has-start-selector> ?value .
  FILTER NOT EXISTS { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#FragmentSelector> }
  FILTER (?value NOT IN ())
  FILTER (isLiteral(?value)
          || EXISTS { ?value ?p2 ?o2 }
          || isBlank(?value)
          || (STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#"))) }""" ] .

ivs:R21 a sh:NodeShape ;
  rdfs:label "iirds:has-end-selector must point at an iirds:FragmentSelector" ;
  sh:severity sh:Violation ;
  sh:message "iirds:has-end-selector must point at an iirds:FragmentSelector" ;
  ivm:ruleId "R21" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Point iirds:has-end-selector at an instance of iirds:FragmentSelector or one of its subclasses. A range with an end that is not a fragment selector names no position in the file, so the range cannot be resolved even though both ends are present." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#information-units:~:text=The%20iirds%3ARangeSelector%20points,end%2Dselector.> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  sh:targetSubjectsOf iirds:has-end-selector ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#has-end-selector> ?value .
  FILTER NOT EXISTS { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#FragmentSelector> }
  FILTER (?value NOT IN ())
  FILTER (isLiteral(?value)
          || EXISTS { ?value ?p2 ?o2 }
          || isBlank(?value)
          || (STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#"))) }""" ] .

ivs:R23 a sh:NodeShape ;
  rdfs:label "iirds:has-classification-domain must point at an iirds:ClassificationDomain" ;
  sh:severity sh:Violation ;
  sh:message "iirds:has-classification-domain must point at an iirds:ClassificationDomain" ;
  ivm:ruleId "R23" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Point iirds:has-classification-domain at an instance of iirds:ClassificationDomain or one of its subclasses. The domain is what makes the classification unambiguous, which is what the appendix asks for in so many words. Pointing at anything else leaves a code with no scheme to read it against." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#external-classification:~:text=An%20external%20classification%20MUST%20point%20to%20exactly%20one%20domain%20by%20the%20iirds%3Ahas%2Dclassification%2Ddomain%20property.%20The%20domain%20is%20an%20instance%20of%20the%20iirdsClassificationDomain%20class.> ;
  ivm:versions "1.2,1.3" ;
  sh:targetSubjectsOf iirds:has-classification-domain ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#has-classification-domain> ?value .
  FILTER NOT EXISTS { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#ClassificationDomain> }
  FILTER (?value NOT IN ())
  FILTER (isLiteral(?value)
          || EXISTS { ?value ?p2 ?o2 }
          || isBlank(?value)
          || (STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/handover#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/machinery#") || STRSTARTS(STR(?value), "http://iirds.tekom.de/iirds/domain/software#"))) }""" ] .

ivs:R34 a sh:NodeShape ;
  rdfs:label "instances of iirds:InformationObject must have an absolute IRI" ;
  sh:severity sh:Violation ;
  sh:message "instances of iirds:InformationObject must have an absolute IRI" ;
  ivm:ruleId "R34" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Give the information object an absolute IRI, such as a urn:uuid: or a URL under a domain you control. An information object is the identity a versioned unit is a version *of*, so a relative one resolves against whichever document is being read and two revisions stop being revisions of the same thing." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#x6-2-2-information-objects> ;
  ivm:covers "x6-2-2-information-objects#3" ;
  sh:targetNode ivs:R34 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#InformationObject> .
  FILTER (!isIRI(?value)
          || !REGEX(STR(?value), "^[A-Za-z][A-Za-z0-9+.-]*:")
          || STR(?value) = "urn:iirds:package:") }""" ] .

ivs:R35 a sh:NodeShape ;
  rdfs:label "instances of iirds:IdentityDomain must have an absolute IRI" ;
  sh:severity sh:Violation ;
  sh:message "instances of iirds:IdentityDomain must have an absolute IRI" ;
  ivm:ruleId "R35" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Give the identity domain an absolute IRI, such as a urn:uuid: or a URL under a domain you control. The domain is what makes a serial number unambiguous; one named relatively is unambiguous only inside the file it was read from." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#x6-8-1-complex-identity> ;
  ivm:covers "x6-8-1-complex-identity#4" ;
  sh:targetNode ivs:R35 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#IdentityDomain> .
  FILTER (!isIRI(?value)
          || !REGEX(STR(?value), "^[A-Za-z][A-Za-z0-9+.-]*:")
          || STR(?value) = "urn:iirds:package:") }""" ] .

ivs:R36 a sh:NodeShape ;
  rdfs:label "instances of iirds:ClassificationDomain must have an absolute IRI" ;
  sh:severity sh:Violation ;
  sh:message "instances of iirds:ClassificationDomain must have an absolute IRI" ;
  ivm:ruleId "R36" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Give the classification domain an absolute IRI, such as the URL of the classification system it names. A classification is only resolvable against the domain it belongs to, and a relative domain names nothing outside this package." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#x6-8-4-external-classification> ;
  ivm:versions "1.2,1.3" ;
  ivm:covers "x6-8-4-external-classification#8" ;
  sh:targetNode ivs:R36 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#ClassificationDomain> .
  FILTER (!isIRI(?value)
          || !REGEX(STR(?value), "^[A-Za-z][A-Za-z0-9+.-]*:")
          || STR(?value) = "urn:iirds:package:") }""" ] .

ivs:R46 a sh:NodeShape ;
  rdfs:label "iirds:Document must relate to a standardised iirds:DocumentType" ;
  sh:severity sh:Violation ;
  sh:message "iirds:Document must relate to a standardised iirds:DocumentType" ;
  ivm:ruleId "R46" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Relate the Document to one of the document types the standard defines -- iirds:OperatingInstructions, iirds:MaintenanceInstructions and the others under iirds:DocumentType -- with iirds:has-document-type. A proprietary document type may stand beside one of them but not in place of them: a consumer routes documents by the standard's types, and a type it has no definition for routes nowhere." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#x6-5-1-types-of-documents-and-topics> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-5-1-types-of-documents-and-topics#1" ;
  sh:targetSubjectsOf iirds:has-document-type, iirds:is-applicable-for-document-type ;
  sh:sparql [ sh:select """SELECT DISTINCT $this WHERE {
  $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#Document> .
  FILTER NOT EXISTS {
    $this <http://iirds.tekom.de/iirds#has-document-type>|<http://iirds.tekom.de/iirds#is-applicable-for-document-type> ?type .
    FILTER (?type IN (<http://iirds.tekom.de/iirds#AdministratorGuide>, <http://iirds.tekom.de/iirds#AssemblyInstructions>, <http://iirds.tekom.de/iirds#BillOfMaterials>, <http://iirds.tekom.de/iirds#CEDeclarationOfConformity>, <http://iirds.tekom.de/iirds#Certificate>, <http://iirds.tekom.de/iirds#ContractualDocument>, <http://iirds.tekom.de/iirds#ElectronicIdentificationPlate>, <http://iirds.tekom.de/iirds#IdentificationDocument>, <http://iirds.tekom.de/iirds#InstallationInstructions>, <http://iirds.tekom.de/iirds#MaintenanceInstructions>, <http://iirds.tekom.de/iirds#OperatingInstructions>, <http://iirds.tekom.de/iirds#PartsCatalog>, <http://iirds.tekom.de/iirds#Plan>, <http://iirds.tekom.de/iirds#QuickGuide>, <http://iirds.tekom.de/iirds#RepairInstructions>, <http://iirds.tekom.de/iirds#SafetyInstructions>, <http://iirds.tekom.de/iirds#SalesCatalog>, <http://iirds.tekom.de/iirds#Specification>, <http://iirds.tekom.de/iirds#TechnicalDrawingDiagram>, <http://iirds.tekom.de/iirds#TransportInstructions>)) } }""" ] .

ivs:R47 a sh:NodeShape ;
  rdfs:label "every root iirds:DirectoryNode must have iirds:has-directory-structure-type" ;
  sh:severity sh:Violation ;
  sh:message "every root iirds:DirectoryNode must have iirds:has-directory-structure-type" ;
  ivm:ruleId "R47" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Give the node iirds:has-directory-structure-type, naming the kind of structure it begins -- iirds:TableOfContents, iirds:Index and the others. A node nothing points at begins a structure, and a consumer that finds one without a type cannot tell what the structure is for. If the node was meant to sit inside another structure, point that structure's iirds:has-first-child or iirds:has-next-sibling at it instead." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#x6-9-1-directory-nodes> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-9-1-directory-nodes#4" ;
  sh:targetNode ivs:R47 ;
  sh:sparql [ sh:select """SELECT $this ?value WHERE {
  ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#DirectoryNode> .
  FILTER NOT EXISTS { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#nil> }
  FILTER (?value != <http://iirds.tekom.de/iirds#nil>)
  FILTER NOT EXISTS {
    ?parent <http://iirds.tekom.de/iirds#has-first-child>|<http://iirds.tekom.de/iirds#has-next-sibling> ?value .
    ?parent <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#DirectoryNode> .
    FILTER NOT EXISTS { ?parent <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#nil> }
    FILTER (?parent != ?value && ?parent != <http://iirds.tekom.de/iirds#nil>) }
  FILTER NOT EXISTS { ?value <http://iirds.tekom.de/iirds#has-directory-structure-type> ?type } }""" ] .

ivs:R48 a sh:NodeShape ;
  rdfs:label "information units related by iirds:is-translation-of must be versions of the same iirds:InformationObject" ;
  sh:severity sh:Violation ;
  sh:message "information units related by iirds:is-translation-of must be versions of the same iirds:InformationObject" ;
  ivm:ruleId "R48" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Relate both units to the same iirds:InformationObject with iirds:is-version-of. The information object is what a translation shares with its original: a consumer looking for the German version of a topic finds it through the object both are versions of, and a pair with no object in common is two unrelated units that say they are one." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#x6-10-2-translation> ;
  ivm:versions "1.3" ;
  ivm:covers "x6-10-2-translation#2" ;
  sh:targetSubjectsOf iirds:is-translation-of ;
  sh:sparql [ sh:select """SELECT DISTINCT $this ?value WHERE {
  $this <http://iirds.tekom.de/iirds#is-translation-of> ?value .
  $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?unit .
  FILTER (?unit IN (<http://iirds.tekom.de/iirds#Document>, <http://iirds.tekom.de/iirds#Fragment>, <http://iirds.tekom.de/iirds#InformationUnit>, <http://iirds.tekom.de/iirds#Package>, <http://iirds.tekom.de/iirds#Topic>))
  { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?other .
    FILTER (?other IN (<http://iirds.tekom.de/iirds#Document>, <http://iirds.tekom.de/iirds#Fragment>, <http://iirds.tekom.de/iirds#InformationUnit>, <http://iirds.tekom.de/iirds#Package>, <http://iirds.tekom.de/iirds#Topic>))
    FILTER NOT EXISTS { $this <http://iirds.tekom.de/iirds#is-version-of> ?object . ?value <http://iirds.tekom.de/iirds#is-version-of> ?object .
                        ?object <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#InformationObject> } }
  UNION
  { FILTER NOT EXISTS { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?elsewhere .
                        FILTER (?elsewhere IN (<http://iirds.tekom.de/iirds#Document>, <http://iirds.tekom.de/iirds#Fragment>, <http://iirds.tekom.de/iirds#InformationUnit>, <http://iirds.tekom.de/iirds#Package>, <http://iirds.tekom.de/iirds#Topic>)) }
    FILTER NOT EXISTS { $this <http://iirds.tekom.de/iirds#is-version-of> ?any .
                        ?any <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://iirds.tekom.de/iirds#InformationObject> } } }""" ] .

ivs:R49 a sh:NodeShape ;
  rdfs:label "dcterms:conformsTo on an iirds:Selector must name a fragment specification the Web Annotation Data Model lists" ;
  sh:severity sh:Violation ;
  sh:message "dcterms:conformsTo on an iirds:Selector must name a fragment specification the Web Annotation Data Model lists" ;
  ivm:ruleId "R49" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Name the specification the selector's rdf:value is written in by the IRI the Web Annotation Data Model's table of fragment selectors gives it: http://tools.ietf.org/rfc/rfc3778 for a page of a PDF file, http://www.w3.org/TR/media-frags/ for a time or region of a media file, and the others in that table. A consumer compares the IRI with the table, so a specification the table does not list, or one of its IRIs spelled another way, leaves the value unreadable." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#x6-3-1-reference-part-of-file-by-selector> ;
  ivm:versions "1.0,1.0.1,1.1,1.2,1.3" ;
  ivm:covers "x6-3-1-reference-part-of-file-by-selector#5" ;
  sh:targetSubjectsOf dcterms:conformsTo ;
  sh:sparql [ sh:select """SELECT DISTINCT $this ?value WHERE {
  $this <http://purl.org/dc/terms/conformsTo> ?value .
  $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?class .
  FILTER (?class IN (<http://iirds.tekom.de/iirds#FragmentSelector>, <http://iirds.tekom.de/iirds#RangeSelector>, <http://iirds.tekom.de/iirds#Selector>))
  FILTER (isBlank(?value)
          || REPLACE(STR(?value), "^\\\\s+|\\\\s+$", "") NOT IN ("http://tools.ietf.org/rfc/rfc3023", "http://tools.ietf.org/rfc/rfc3236", "http://tools.ietf.org/rfc/rfc3778", "http://tools.ietf.org/rfc/rfc3870", "http://tools.ietf.org/rfc/rfc5147", "http://tools.ietf.org/rfc/rfc7111", "http://www.idpf.org/epub/linking/cfi/epub-cfi.html", "http://www.w3.org/TR/SVG/", "http://www.w3.org/TR/media-frags/")) }""" ] .

ivs:R61 a sh:NodeShape ;
  rdfs:label "disjoint iiRDS classes must not have instances in common" ;
  sh:severity sh:Violation ;
  sh:message "disjoint iiRDS classes must not have instances in common" ;
  ivm:ruleId "R61" ;
  ivm:ruleSource "iirds-validate" ;
  sh:description "Remove an inaccurate type assertion, correct the package's class declarations, or classify the resource under the appropriate branch. If it combines two distinct things, give each its own resource and link them with the appropriate iiRDS relation." ;
  dcterms:source <https://www.iirds.org/fileadmin/iiRDS_specification/20251103-1.3-release/index.html#x6-11-1-disjointness> ;
  ivm:versions "1.3" ;
  ivm:covers "x6-11-1-disjointness#1" ;
  sh:targetNode ivs:R61 ;
  sh:sparql [ sh:select """SELECT DISTINCT $this ?value WHERE {
  { { SELECT $this ?value ?basisFirst ?basisSecond WHERE {
    { SELECT $this ?value
                                 (GROUP_CONCAT(?ancestors; separator="") AS ?closure) WHERE {
  { { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?type }
  UNION {
    ?value ?usedProperty ?object .
    BIND (IF(EXISTS {
    ?child <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> ?parent
  }, <https://iirds.dev/shapes#R61SuperProperties>(?usedProperty, ""), IF(CONTAINS("!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23classificationIdentifier!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23classificationIdentifier||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsAttribute|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23classificationVersion!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23classificationVersion||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsAttribute|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23dateOfCreation!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23dateOfCreation||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsAttribute||http%3A%2F%2Fpurl.org%2Fdc%2Fterms%2Fcreated|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23dateOfEffect!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23dateOfEffect||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsAttribute|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23dateOfExpiry!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23dateOfExpiry||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsAttribute|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23dateOfLastModification!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23dateOfLastModification||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsAttribute|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23dateOfStatus!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23dateOfStatus||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsAttribute|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23description!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23description||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsAttribute||http%3A%2F%2Fpurl.org%2Fdc%2Fterms%2Fdescription|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23duration!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23duration||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsAttribute|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23format!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23format||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsAttribute||http%3A%2F%2Fpurl.org%2Fdc%2Fterms%2Fformat|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23formatRestriction!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23formatRestriction||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsAttribute|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23frequency!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23frequency||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsAttribute|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-abstract!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-abstract||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsRelationConcept||http%3A%2F%2Fpurl.org%2Fdc%2Fterms%2Fabstract|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-classification-domain!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-classification-domain||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsRelationConcept|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-classification-type!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-classification-type||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsRelationConcept|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-component!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-component||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsRelationConcept|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-content-lifecycle-status!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-content-lifecycle-status||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsRelationConcept||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23relates-to-administrative-metadata|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-content-lifecycle-status-value!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-content-lifecycle-status-value||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsRelationConcept|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-directory-structure-type!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-directory-structure-type||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsRelationConcept|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-document-type!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-document-type||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-information-type||http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsRelationConcept|!!http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-end-selector!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23has-end-selector||http%3A%2F%2Fiirds.tekom.de%2Fiirds%2