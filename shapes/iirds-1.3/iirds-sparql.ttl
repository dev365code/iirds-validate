n%2Fsoftware%23iirdsSoftwareDomainEntity!|http%3A%2F%2Fiirds.tekom.de%2Fiirds%23iirdsDomainEntity||http%3A%2F%2Fiirds.tekom.de%2Fiirds%2Fdomain%2Fsoftware%23iirdsSoftwareDomainEntity|!", CONCAT("!", ENCODE_FOR_URI(STR(?cls)), "!")), "!"), CONCAT("|", ENCODE_FOR_URI(STR(?cls)), "|")) AS ?localBase)
      ?source (<http://www.w3.org/2000/01/rdf-schema#subClassOf>|<http://www.w3.org/2002/07/owl#equivalentClass>|^<http://www.w3.org/2002/07/owl#equivalentClass>) ?step .
      FILTER (CONTAINS(?localBase, CONCAT("|", ENCODE_FOR_URI(STR(?source)), "|")))
      FILTER (!CONTAINS(?seen, CONCAT("|", ENCODE_FOR_URI(STR(?cls)), "|")))
      BIND (CONCAT(?seen, ?localBase) AS ?newSeen)
    } GROUP BY ?step }
    BIND (<https://iirds.dev/shapes#R61Ancestors>(?child, ?visited) AS ?part)
  } }
